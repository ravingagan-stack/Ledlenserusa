<div
  class="quiz--step-{{ block.settings.step }} {{ class }} step-770 quiz--bg"
  style="--desktopimg: url({{ block.settings.bg_img | img_url: 'master' }}); --mobileimg: url({{ block.settings.mobile_img | img_url: 'master' }});"
  data-category="{{ block.settings.category }}"
  data-type="block-selector"
  data-tag-prefix="{{ block.settings.tag_prefix }}"
  data-condition-tags="{{ block.settings.display_condition_tags }}"
  data-image="{{ block.settings.bg_img | img_url: 'master' }}"
>
  {%- if block.settings.title != blank -%}
    <h2 class="quiz--step_h2">{{ block.settings.title }}</h2>
  {%- endif -%}

  <div class="quiz--product_main quiz--block__selector">
    {%- for i in (1..4) -%}
      {% capture image_id %}ch_{{ i }}_icon{% endcapture %}
      {% capture title_id %}ch_{{ i }}_title{% endcapture %}
      {% capture svg_id %}ch_{{ i }}_svg{% endcapture %}
      {% capture description_id %}ch_{{ i }}_description{% endcapture %}

      {%- if block.settings[title_id] != blank -%}
        <label
          class="quiz--step-option {% if block.settings[svg_id] != blank %}quiz--step-svg_main{% endif %}"
          data-step="{{ block.settings.step }}"
          data-type="block-selector"
        >
          <input
            type="radio"
            name="swatch-{{ block.settings.step }}-{{ block.settings.tag_prefix }}"
            value="{{ block.settings[title_id] }}"
          >
          <div class="product-switch {% if block.settings[svg_id] != blank %}quiz--step-svg{% endif %}">
            {%- if block.settings[image_id] != blank -%}
              <span class="product-switch_img">
                <img src="{{ block.settings[image_id] | img_url: 'master' }}">
              </span>
            {%- endif -%}
            <h6>
              {{ block.settings[svg_id] }}
              {{ block.settings[title_id] | replace: '_', '+' }}
            </h6>
            {%- if block.settings[description_id] != blank -%}
              <p>{{ block.settings[description_id] }}</p>
            {%- endif -%}
          </div>
        </label>
      {% endif %}
    {%- endfor -%}
  </div>
  {%- if block.settings.cta_label != blank -%}
    <button class="quiz--product-button btn--next" disabled>{{ block.settings.cta_label }}</button>
  {%- endif -%}
  {%- if block.settings.is_optional -%}
    <button class="button--text quiz--product-button btn--skip button--full">I’M NOT SURE, SKIP</button>
  {%- endif -%}
</div>
