{%- comment -%}
  Best sellers section
  - Products come from the collection selected in the theme editor
  - "Quick add" uses the theme's <product-form> element, so the product is added
    via AJAX and the cart drawer refreshes and opens automatically
    (Theme settings > Cart > Cart type must be set to "Drawer")
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign selected_products = section.settings.product_list
  assign product_count = 0

  if selected_products != blank and selected_products.count > 0
    assign product_source = selected_products
    assign product_count = selected_products.count
  elsif collection != blank
    assign product_source = collection.products
    assign product_count = collection.products_count
  endif

  assign products_limit = section.settings.products_limit
  assign section_uid = 'BestSellers-' | append: section.id

  if section.settings.link_url != blank
    assign shop_all_url = section.settings.link_url
  elsif collection != blank
    assign shop_all_url = collection.url
  else
    assign shop_all_url = routes.all_products_collection_url
  endif
-%}

{%- style -%}
  #{{ section_uid }} {
    max-width: 1408px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }

  #{{ section_uid }} .bs__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 8px;
  }

  #{{ section_uid }} .bs__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 44px;
    line-height: 1;
    margin: 0;
  }

  #{{ section_uid }} .bs__link {
    font-weight: 600;
    font-size: 16px;
    font-family: Barlow, Helvetica Neue, sans-serif;
    line-height: 20px;
    text-decoration: underline;
    color: #0a0a0a;
  }

  #{{ section_uid }} .bs__subtitle {
    margin: 0 0 24px;
    color: {{ section.settings.color_muted }};
    font-size: 16px;
        font-family: Barlow, Helvetica Neue, sans-serif;
  }
/* comment for new code */
/*
  #{{ section_uid }} .bs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  } */

  #{{ section_uid }} .bs-card {
    border: 1px solid {{ section.settings.color_border }};
    display: flex;
    flex-direction: column;
    background: {{ section.settings.color_card_bg }};
