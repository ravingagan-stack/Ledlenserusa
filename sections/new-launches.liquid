{% comment %}
  Just Launched: New H & HF Series
  Picks a single collection and auto-renders its products.
  Status + spec auto-pulled from product tag / metafield / description.
{% endcomment %}

{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}

<style>
  .ll-launch {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: 'Barlow', 'Helvetica Neue', sans-serif;
  }
  .ll-launch * { box-sizing: border-box; }

  .ll-launch__inner {
    max-width: 1408px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }

  /* ---------- Header ---------- */
  .ll-launch__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 24px;
  }

  .ll-launch__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 44px;
    line-height: 1;
    letter-spacing: 0.01em;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .ll-launch__link {
    font-weight: 600;
    font-size: 16px;
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }
  .ll-launch__link:hover { color: {{ section.settings.accent_color }}; }

  /* ---------- Track ---------- */
  .ll-launch__track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  /* ---------- Card ---------- */
  .ll-launch__card {
    text-decoration: none;
    color: {{ section.settings.text_color }};
    border: 1px solid {{ section.settings.border_color }};
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: {{ section.settings.card_bg }};
    transition: border-color .15s ease;
  }
  .ll-launch__card:hover { border-color: {{ section.settings.accent_color }}; }

  .ll-launch__img {
    height: 150px;
    background: {{ section.settings.img_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ll-launch__img img {
    width: 100%; height: 100%;
    object-fit: contain;
    display: block;
    background: #ffffff;
  }

  .ll-launch__status {
    align-self: flex-start;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height:14px;
    padding: 4px 8px;
    border: 1.5px solid {{ section.settings.accent_color }};
    color: {{ section.settings.accent_dark }};
    background: {{ section.settings.card_bg }};
  }

  .ll-launch__name {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 24px;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
  }

  .ll-launch__spec {
    font-size: 14px;
    color: {{ section.settings.muted_color }};
        font-family: Barlow, Helvetica Neue, sans-serif;
               line-height:17px;
  }

  .ll-launch__price {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 22px;
    margin-top: auto;
            line-height:26px;
  }

  /* ---------- Empty state ---------- */
  .ll-launch__empty {
    padding: 24px;
    border: 1px dashed {{ section.settings.border_color }};
    color: {{ section.settings.muted_color }};
    font-size: 15px;
    text-align: center;
  }

  /* ---------- Mobile slider ---------- */
    /* ---------- Mobile slider (768px and below) ---------- */
  @media (max-width: 768px) {
    .ll-launch__inner { padding-left: 0px; padding-right: 0px; }
    .ll-launch__heading { font-size: 30px; }

    .ll-launch__track {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 12px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .ll-launch__track::-webkit-scrollbar { display: none; }

    /* Below 520px: 1 card per view */
    .ll-launch__card {
      flex: 0 0 90%;
    }
.ll-launch__track {
    padding: 0 20px;
}

.ll-launch__header {
    padding: 0 20px;
}
    .ll-launch__img { height: 150px; }
  }

  /* ---------- 520px to 768px: 2 cards per view ---------- */
  @media (min-width: 520px) and (max-width: 768px) {
    .ll-launch__card {
      flex: 0 0 calc(50% - 6px);   /* 2 cards + 12px gap = 100% */
      scroll-snap-align: start;
    }

    .ll-launch__img { height: 150px; }
    .ll-launch__name { font-size: 22px; }
    .ll-launch__price { font-size: 20px; }
  }
  
</style>

<section class="ll-launch" aria-label="{{ section.settings.heading | default: 'New launches' | escape }}">
  <div class="ll-launch__inner">

    <div class="ll-launch__header">
      {% if section.settings.heading != blank %}
        <h2 class="ll-launch__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="ll-launch__link">
          {{ section.settings.view_all_text }} &rarr;
        </a>
      {% endif %}
    </div>

    <div class="ll-launch__track" role="list">

      {%- if coll != blank and coll.products.size > 0 -%}
        {%- for product in coll.products limit: limit -%}

          {%- comment -%} --- Status badge logic --- {%- endcomment -%}
          {%- assign status_text = '' -%}
          {%- if product.metafields.custom.badge != blank -%}
            {%- assign status_text = product.metafields.custom.badge.value -%}
          {%- elsif product.tags contains 'Pre-order' -%}
            {%- assign status_text = section.settings.preorder_text -%}
          {%- elsif product.tags contains 'New' -%}
            {%- assign status_text = section.settings.new_text -%}
          {%- elsif section.settings.default_status != blank -%}
            {%- assign status_text = section.settings.default_status -%}
          {%- endif -%}

          {%- comment -%} --- Spec line logic --- {%- endcomment -%}
            {%- assign spec_text = '' -%}
            {%- liquid
            assign spec_key_1 = product.metafields.custom.max_lumens | metafield_text
            assign spec_key_2 = product.metafields.custom.beam_range | metafield_text
            assign spec_key_3 = product.metafields.custom.runtime_range.value
            -%}
            {%- if spec_key_1 != blank -%}
              {%- capture spec_key_1 -%}{%- render 'spec-lumens', value: spec_key_1 -%}{%- endcapture -%}
            {%- endif -%}
            {%- if spec_key_2 != blank -%}
              {%- capture spec_key_2 -%}{%- render 'beam-distance', value: spec_key_2, format: 'm' -%}{%- endcapture -%}
            {%- endif -%}

            {%- if spec_key_1 != blank -%}
            {%- assign spec_text = spec_text | append: spec_key_1 -%}
            {%- endif -%}

            {%- if spec_key_2 != blank -%}
            {%- if spec_text != blank -%}
                {%- assign spec_text = spec_text | append: ' · ' -%}
            {%- endif -%}
            {%- assign spec_text = spec_text | append: spec_key_2 -%}
            {%- endif -%}

            {%- if spec_key_3 != blank -%}
            {%- if spec_text != blank -%}
                {%- assign spec_text = spec_text | append: ' · ' -%}
            {%- endif -%}
            {%- assign spec_text = spec_text | append: spec_key_3 -%}
            {%- endif -%}

          <a href="{{ product.url }}" class="ll-launch__card" role="listitem">

            <div class="ll-launch__img">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    widths: '250,500',
                    sizes: '240px',
                    alt: product.title | escape
                }}
              {% endif %}
            </div>

            {% if status_text != blank %}
              <span class="ll-launch__status">{{ status_text }}</span>
            {% endif %}

            <h3 class="ll-launch__name">{{ product.title }}</h3>

            {% if spec_text != blank %}
              <div class="ll-launch__spec">{{ spec_text }}</div>
            {% endif %}

            <div class="ll-launch__price">{{ product.price | money }}</div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <div class="ll-launch__empty">
          Pick a collection in the section settings to display its products.
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Launched",
  "tag": "section",
  "class": "section-just-launched",
  "settings": [
    { "type": "header", "content": "Collection" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Max products",
      "min": 2, "max": 24, "step": 1,
      "default": 4
    },

    { 
      "type": "header", 
      "content": "Status badge" 
    },
    {
      "type": "text",
      "id": "preorder_text",
      "label": "Pre-order badge text",
      "info": "Shown when a product has the tag 'Pre-order'."
    },
    {
      "type": "text",
      "id": "new_text",
      "label": "New badge text",
      "info": "Shown when a product has the tag 'New'."
    },
    {
      "type": "text",
      "id": "default_status",
      "label": "Fallback badge text",
      "info": "Shown when no tag or metafield matches. Leave blank to hide."
    },

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View-all text",
    },
    { 
      "type": "url",
      "id": "view_all_link",
      "label": "View-all link"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F5F0EA"
    },
    { 
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "img_bg",
      "label": "Image tile bg",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#DADADA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "muted_color", 
      "label": "Muted text",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (badge border)",
      "default": "#E30613"
    },
    { 
      "type": "color",
      "id": "accent_dark",
      "label": "Accent text",
      "default": "#B8000F"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "New Launched"
    }
  ]
}
{% endschema %}