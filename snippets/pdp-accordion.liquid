{%- comment -%} Accordion item — opening markup. Pair with pdp-accordion-end. Params: title, open, id {%- endcomment -%}
<div class="pdp-acc{% if open %} open{% endif %}"{% if id != blank %} id="{{ id }}"{% endif %}>
  <button class="pdp-acc__head" type="button" aria-expanded="{% if open %}true{% else %}false{% endif %}">
    <span class="pdp-acc__title">{{ title }}</span>
    <svg class="pdp-acc__chev" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
  </button>
  <div class="pdp-acc__panel"><div class="pdp-acc__inner"><div class="pdp-acc__body">
