    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true,
      "info": "Uses the standard reviews.rating and reviews.rating_count metafields set by review apps"
    },
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Reviews label",
      "default": "reviews"
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "text",
      "id": "use_metafield",
      "label": "Use case metafield",
      "default": "custom.use_case",
      "info": "Format: namespace.key. Falls back to product type."
    },
    {
      "type": "text",
      "id": "spec_1_label",
      "label": "Spec 1 label",
      "default": "Output"
    },
    {
      "type": "text",
      "id": "spec_1_metafield",
      "label": "Spec 1 metafield",
      "default": "custom.max_lumens"
    },
    {
      "type": "text",
      "id": "spec_2_label",
      "label": "Spec 2 label",
      "default": "Distance"
    },
    {
      "type": "text",
      "id": "spec_2_metafield",
      "label": "Spec 2 metafield",
      "default": "custom.beam_distance"
    },
    {
      "type": "text",
      "id": "spec_3_label",
      "label": "Spec 3 label",
      "default": "Runtime"
    },
    {
      "type": "text",
      "id": "spec_3_metafield",
      "label": "Spec 3 metafield",
      "default": "custom.runtime"
    },
    {
      "type": "text",
      "id": "chip_metafield",
      "label": "Chip metafield",
      "default": "custom.chip",
      "info": "Format: namespace.key"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart button label",
      "default": "Quick add"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "details_label",
      "label": "Details link label",
      "default": "View details"
    },
    {
      "type": "header",
      "content": "Colors"
    },
