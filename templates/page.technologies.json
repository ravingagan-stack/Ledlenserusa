        "image_width": "standard",
        "image": "shopify://shop_images/widebeam_e7f1452f-734a-4402-a071-429949122be0.webp",
        "color_scheme": "scheme-1",
        "section_width": "wrapper",
        "padding_top": 40,
        "padding_bottom": 20
      }
    },
    "section_image_with_text_waBbe6": {
      "type": "section-image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "title": "<p><strong>Optisense Technology</strong></p>",
            "size": 100,
            "text_position": "left",
            "heading_highlight_type": "circle",
            "highlight_color": "#d43747",
            "highlight_text_color": "#000000",
            "spacing_bottom": 12
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Whether it's dusky, shadowy, dim or pitch-black: With the Optisense technology your Ledlenser will automatically adapt to the present light conditions. The innovative dimmer controls the luminosity based on the reflecting surrounding light, and avoids annoying glare effects.</p>",
            "size": 100,
            "text_position": "left",
            "spacing_bottom": 12
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ],
      "settings": {
        "increase_border_radius": false,
