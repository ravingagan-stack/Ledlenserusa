        "panel_ywBAVG": {
          "type": "panel",
          "settings": {
            "title": "Specifications",
            "custom_code": "<style>\n#CustomTabs--template--20177705402446__custom_tabs_DATTdN .scope-grid {\n  display: flex;\n  justify-content: center;\n}\n\n.technical-data-table {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  margin-top: 20px;\n}\n\n.spec-block {\n  border-top: 3px solid #000;\n  background: #fff;\n}\n\n.spec-block h4 {\n  background: #000;\n  color: #fff;\n  padding: 8px;\n  font-size: 14px;\n  text-transform: uppercase;\n  margin: 0;\n}\n\n.spec-block ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.spec-block li {\n  display: flex;\n  justify-content: space-between;\n  padding: 6px 10px;\n  border-bottom: 1px solid #ddd;\n  font-size: 13px;\n}\n\n.spec-block li span:first-child {\n  color: #555;\n}\n\n.spec-block li span:last-child {\n  font-weight: 500;\n}\n\n.spec-block p {\n  padding: 10px;\n  font-size: 13px;\n  margin: 0;\n}\n\n.light-values-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 13px;\n}\n\n.light-values-table th,\n.light-values-table td {\n  padding: 8px 10px;\n  border-bottom: 1px solid #ddd;\n  text-align: center;\n}\n\n.light-values-table th:first-child,\n.light-values-table td:first-child {\n  text-align: left;\n  color: #555;\n}\n\n.light-values-table thead th {\n  background: #f5f5f5;\n  font-weight: 600;\n}\n\n@media (max-width: 768px) {\n  .technical-data-table {\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n  }\n\n  .spec-block {\n    width: 100%;\n  }\n\n  .spec-block ul {\n    width: 100%;\n  }\n\n  .spec-block li {\n    display: block;\n    padding: 10px;\n  }\n\n  .spec-block li span {\n    display: block;\n    width: 100%;\n  }\n\n  .spec-block li span:first-child {\n    font-size: 12px;\n    color: #777;\n    margin-bottom: 2px;\n  }\n\n  .spec-block li span:last-child {\n    font-size: 14px;\n    font-weight: 600;\n    color: #000;\n  }\n\n  .light-values-table {\n    display: block;\n    width: 100%;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .light-values-table th,\n  .light-values-table td {\n    font-size: 12px;\n    padding: 8px;\n    white-space: nowrap;\n  }\n\n  .spec-block h4 {\n    font-size: 13px;\n    padding: 8px;\n  }\n\n  .tabs,\n  .product-tabs,\n  .tab-list {\n    display: flex;\n    flex-wrap: wrap;\n    overflow-x: auto;\n    white-space: nowrap;\n    border-bottom: 1px solid #ddd;\n  }\n\n  .tabs button,\n  .product-tabs button,\n  .tab-list button {\n    flex: 0 0 auto;\n    padding: 10px 12px;\n    font-size: 12px;\n  }\n\n  .tab-buttons {\n    justify-content: left !important;\n    display: flex !important;\n    flex-wrap: wrap !important;\n    overflow-x: auto !important;\n    overflow-y: hidden !important;\n    white-space: nowrap !important;\n    width: 100% !important;\n    padding: 0 10px !important;\n    gap: 8px !important;\n    -webkit-overflow-scrolling: touch !important;\n    scrollbar-width: none !important;\n    background: #ffffff !important;\n  }\n\n  .tab-buttons::-webkit-scrollbar {\n    display: none !important;\n  }\n\n  .tab-buttons .tab-button {\n    flex: 0 0 auto !important;\n    display: inline-block !important;\n    white-space: nowrap !important;\n    padding: 10px 14px !important;\n    font-size: 13px !important;\n    background: #000 !important;\n    color: #fff !important;\n    border-radius: 3px !important;\n  }\n\n  .tab-buttons .tab-button.active {\n    background: #333 !important;\n  }\n\n  [data-tab-content],\n  [data-tab-panel],\n  .tab-panel,\n  .tab-content {\n    max-height: none !important;\n    height: auto !important;\n    overflow: visible !important;\n  }\n}\n</style>\n\n{%- assign td = product.metafields.custom.technical_data.value -%}\n\n{% if td %}\n\n<div class=\"technical-data-table\">\n\n  <div class=\"spec-block\">\n    <h4>Technical Data</h4>\n    <ul>\n      {% if td.td_weight != blank %}\n        <li><span>Weight incl. batteries [g]</span><span>{{ td.td_weight }}</span></li>\n      {% endif %}\n\n      {% if td.td_material != blank %}\n        <li><span>Material</span><span>{{ td.td_material }}</span></li>\n      {% endif %}\n\n      {% if td.td_luminous_range != blank %}\n        <li><span>Luminous range [m]</span><span>{{ td.td_luminous_range }}</span></li>\n      {% endif %}\n\n      {% if td.td_luminous_range_focused != blank %}\n        <li><span>Luminous range focused [m]</span><span>{{ td.td_luminous_range_focused }}</span></li>\n      {% endif %}\n\n      {% if td.td_tube_diameter != blank %}\n        <li><span>Tube diameter [mm]</span><span>{{ td.td_tube_diameter }}</span></li>\n      {% endif %}\n\n      {% if td.td_head_diameter != blank %}\n        <li><span>Head diameter [mm]</span><span>{{ td.td_head_diameter }}</span></li>\n      {% endif %}\n    </ul>\n  </div>\n\n  <div class=\"spec-block\">\n    <h4>Power Supply</h4>\n    <ul>\n      {% if td.td_battery_quantity != blank %}\n        <li><span>Battery quantity</span><span>{{ td.td_battery_quantity }}</span></li>\n      {% endif %}\n\n      {% if td.td_rechargeable != blank %}\n        <li><span>Rechargeable</span><span>{{ td.td_rechargeable }}</span></li>\n      {% endif %}\n\n      {% if td.td_battery_type != blank %}\n        <li><span>Battery type</span><span>{{ td.td_battery_type }}</span></li>\n      {% endif %}\n\n      {% if td.td_battery_voltage != blank %}\n        <li><span>Total battery voltage [V]</span><span>{{ td.td_battery_voltage }}</span></li>\n      {% endif %}\n\n      {% if td.td_battery_capacity != blank %}\n        <li><span>Total battery capacity [mAh]</span><span>{{ td.td_battery_capacity }}</span></li>\n      {% endif %}\n\n      {% if td.td_battery_energy != blank %}\n        <li><span>Total battery energy [Wh]</span><span>{{ td.td_battery_energy }}</span></li>\n      {% endif %}\n\n      {% if td.td_charging_time != blank %}\n        <li><span>Charging time [min]</span><span>{{ td.td_charging_time }}</span></li>\n      {% endif %}\n    </ul>\n  </div>\n\n  <div class=\"spec-block\">\n    <h4>Further Specifications</h4>\n    <ul>\n      {% if td.td_ip_class != blank %}\n        <li><span>IP class</span><span>{{ td.td_ip_class }}</span></li>\n      {% endif %}\n\n      {% if td.td_drop_test != blank %}\n        <li><span>Drop test [m]</span><span>{{ td.td_drop_test }}</span></li>\n      {% endif %}\n\n      {% if td.td_temperature_range != blank %}\n        <li><span>Working temperature [°C]</span><span>{{ td.td_temperature_range }}</span></li>\n      {% endif %}\n    </ul>\n  </div>\n\n  {% if td.td_light_functions != blank %}\n    <div class=\"spec-block\">\n      <h4>Light Functions</h4>\n      <p>{{ td.td_light_functions }}</p>\n    </div>\n  {% endif %}\n\n  <div class=\"spec-block\">\n    <h4>Light Source</h4>\n    <ul>\n      {% if td.td_led_count != blank %}\n        <li><span>Amount LEDs</span><span>{{ td.td_led_count }}</span></li>\n      {% endif %}\n\n      {% if td.td_light_color != blank %}\n        <li><span>Color</span><span>{{ td.td_light_color }}</span></li>\n      {% endif %}\n\n      {% if td.td_color_temperature != blank %}\n        <li><span>Color temperature [K]</span><span>{{ td.td_color_temperature }}</span></li>\n      {% endif %}\n\n      {% if td.td_cri != blank %}\n        <li><span>CRI</span><span>{{ td.td_cri }}</span></li>\n      {% endif %}\n    </ul>\n  </div>\n\n  <div class=\"spec-block\">\n    <h4>Light Values</h4>\n\n{% assign output = td.td_light_output | default: '' %}\n{% assign beam = td.td_beam_distance | default: '' %}\n{% assign runtime = td.td_runtime | default: '' %}\n\n{% assign output_parts = output | split: ' Power:' %}\n{% assign beam_parts = beam | split: ' Power:' %}\n{% assign runtime_parts = runtime | split: ' Power:' %}\n\n{% assign out_boost = output_parts[0] | remove: 'Boost:' | strip %}\n{% assign out_power = output_parts[1] | split: ' Mid' | first | strip %}\n{% assign out_mid = output_parts[2] | split: ' Low' | first | strip %}\n{% assign out_low = output_parts[3] | strip %}\n\n{% assign beam_boost = beam_parts[0] | remove: 'Boost:' | strip %}\n{% assign beam_power = beam_parts[1] | split: ' Mid' | first | strip %}\n{% assign beam_mid = beam_parts[2] | split: ' Low' | first | strip %}\n{% assign beam_low = beam_parts[3] | strip %}\n\n{% assign run_boost = runtime_parts[0] | remove: 'Boost:' | strip %}\n{% assign run_power = runtime_parts[1] | split: ' Mid' | first | strip %}\n{% assign run_mid = runtime_parts[2] | split: ' Low' | first | strip %}\n{% assign run_low = runtime_parts[3] | strip %}\n\n    <table class=\"light-values-table\">\n      <thead>\n        <tr>\n          <th></th>\n          <th>Boost</th>\n          <th>Power</th>\n          <th>Mid power</th>\n          <th>Low power</th>\n        </tr>\n      </thead>\n\n      <tbody>\n        <tr>\n          <td>Luminous flux (lm)</td>\n          <td>{{ out_boost }}</td>\n          <td>{{ out_power }}</td>\n          <td>{{ out_mid }}</td>\n          <td>{{ out_low }}</td>\n        </tr>\n\n        <tr>\n          <td>Beam range (m)</td>\n          <td>{{ beam_boost }}</td>\n          <td>{{ beam_power }}</td>\n          <td>{{ beam_mid }}</td>\n          <td>{{ beam_low }}</td>\n        </tr>\n\n        <tr>\n          <td>Duration (h)</td>\n          <td>{{ run_boost }}</td>\n          <td>{{ run_power }}</td>\n          <td>{{ run_mid }}</td>\n          <td>{{ run_low }}</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n  {% if td.td_switch != blank %}\n    <div class=\"spec-block\">\n      <h4>Switch</h4>\n      <p>{{ td.td_switch }}</p>\n    </div>\n  {% endif %}\n\n  {% if td.td_features != blank %}\n    <div class=\"spec-block\">\n      <h4>Features</h4>\n      <p>{{ td.td_features }}</p>\n    </div>\n  {% endif %}\n\n</div>\n\n{% else %}\n\n<p style=\"padding: 20px; color: #777; font-size: 14px;\">\n  Technical data not available for this product.\n</p>\n\n{% endif %}"
          }
