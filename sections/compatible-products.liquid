{%- comment -%}
  Compatible products: on a product page, shows the products that work with
  the product being viewed (e.g. the lights a powerbank can charge).

  Managed in the theme editor, no metafields needed:
    Product page > Compatible products > "Compatible group" block
      - Show on these products: e.g. Flex5 Powerbank, Flex10 Powerbank
      - Compatible products:    the lights they support
  The first group that lists the current product is used.

  Optional fallback: if no group matches and the product has a
  "List of products" metafield (default custom.compatible_products), that is used.

  The section renders nothing when there is nothing to show, so it can stay on
  the product template for every product.

  Cards: snippets/product-card-bs.liquid (same card as the collection grid).
{%- endcomment -%}

{%- liquid
  assign section_uid = 'CompatibleProducts-' | append: section.id
  assign compatible = blank
  assign group_heading = ''
  assign group_subheading = ''
  assign group_attributes = ''
  assign group_found = false

  for block in section.blocks
    if block.type != 'group' or group_found
      continue
    endif
    for target in block.settings.products
      if target.id == product.id and block.settings.compatible.size > 0
        assign compatible = block.settings.compatible
        assign group_heading = block.settings.heading
        assign group_subheading = block.settings.subheading
        assign group_attributes = block.shopify_attributes
        assign group_found = true
        break
      endif
    endfor
  endfor

  unless group_found
    assign mf_parts = section.settings.metafield | default: 'custom.compatible_products' | strip | split: '.'
    assign compatible = product.metafields[mf_parts[0]][mf_parts[1]].value
  endunless

  assign heading = group_heading | default: section.settings.heading
  assign subheading = group_subheading | default: section.settings.subheading

  assign item_count = 0
  if compatible != blank
    for item in compatible
      if item.id == product.id
        continue
      endif
      if section.settings.hide_sold_out and item.available == false
        continue
      endif
      if item_count >= section.settings.limit
        break
      endif
      assign item_count = item_count | plus: 1
    endfor
  endif
-%}

{%- if item_count > 0 -%}
  {{ 'component-bs-card.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    #{{ section_uid }} {
      background: {{ section.settings.color_bg }};
      color: {{ section.settings.color_text }};
    }
    #{{ section_uid }} .compat__inner {
      max-width: 1320px;
      margin: 0 auto;
      padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    }
    @media (max-width: 749px) {
      #{{ section_uid }} .compat__inner {
        padding: {{ section.settings.padding_top | times: 0.7 | round }}px 16px {{ section.settings.padding_bottom | times: 0.7 | round }}px;
      }
    }
  {%- endstyle -%}

  <section id="{{ section_uid }}" class="compat" aria-labelledby="{{ section_uid }}-title" {{ group_attributes }}>
    <div class="compat__inner">
      <div class="compat__head">
        <div class="compat__head-text">
          {%- if heading != blank -%}
            <h2 id="{{ section_uid }}-title" class="compat__title">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if subheading != blank -%}
            {%- assign product_title_escaped = product.title | escape -%}
            <p class="compat__sub">{{ subheading | escape | replace: '[product]', product_title_escaped }}</p>
          {%- endif -%}
        </div>

        {%- if item_count > 1 -%}
          <div class="compat__nav">
            <button type="button" class="compat__arrow" data-compat-prev aria-label="Previous compatible products" aria-controls="{{ section_uid }}-track">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <button type="button" class="compat__arrow" data-compat-next aria-label="Next compatible products" aria-controls="{{ section_uid }}-track">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <div
        id="{{ section_uid }}-track"
        class="compat__track"
        data-compat-track
        role="region"
        aria-label="{{ heading | default: 'Compatible products' | escape }}"
        tabindex="0"
      >
        {%- assign rendered = 0 -%}
        {%- for item in compatible -%}
          {%- liquid
            if item.id == product.id
              continue
            endif
            if section.settings.hide_sold_out and item.available == false
              continue
            endif
            if rendered >= section.settings.limit
              break
            endif
            assign rendered = rendered | plus: 1
          -%}
          {%- render 'product-card-bs', product: item, columns: 4, columns_mobile: 2 -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('{{ section_uid }}');
      if (!root || root.dataset.compatReady) return;
      root.dataset.compatReady = '1';
      var track = root.querySelector('[data-compat-track]');
      var prev = root.querySelector('[data-compat-prev]');
      var next = root.querySelector('[data-compat-next]');
      if (!track || !prev || !next) return;

      function step() {
        var card = track.querySelector('.bs-collection-item');
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        var cardW = card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
        // Scroll by as many whole cards as fit in the view
        return Math.max(cardW, Math.floor(track.clientWidth / cardW) * cardW);
      }
      function update() {
        var atStart = track.scrollLeft <= 2;
        var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
        prev.disabled = atStart;
        next.disabled = atEnd;
        root.classList.toggle('compat--no-scroll', atStart && atEnd);
      }
      prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="compat compat--empty" style="max-width:1320px;margin:0 auto;padding:24px;">
    <p style="margin:0;padding:16px;border:1px dashed #bbb;font-size:14px;color:#666;">
      <strong>Compatible products:</strong> nothing to show for {{ product.title | escape }}.
      Add a <em>Compatible group</em> block to this section, add this product under
      "Show on these products", then pick its compatible products.
      This note is only visible in the theme editor.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Compatible products",
  "class": "section-compatible-products",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a 'Compatible group' block for each set of products (e.g. Flex5 + Flex10 powerbanks), then pick the products they work with. The section is hidden on products that aren't in any group."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compatible products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Products that work with the [product]",
      "info": "[product] is replaced with the product title. Leave empty to hide."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold out products",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#0a0a0a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "Metafield fallback (namespace.key)",
      "default": "custom.compatible_products",
      "info": "Optional. Used only when no block lists the product and the product has a 'List of products' metafield with this key."
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Compatible group",
      "settings": [
        {
          "type": "product_list",
          "id": "products",
          "label": "Show on these products",
          "info": "The product pages this list appears on, e.g. Flex5 Powerbank and Flex10 Powerbank.",
          "limit": 50
        },
        {
          "type": "product_list",
          "id": "compatible",
          "label": "Compatible products",
          "info": "The products shown in the slider, in this order.",
          "limit": 50
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading override",
          "info": "Leave empty to use the section heading."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading override",
          "info": "[product] is replaced with the product title. Leave empty to use the section subheading."
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Compatible products"
    }
  ]
}
{% endschema %}
