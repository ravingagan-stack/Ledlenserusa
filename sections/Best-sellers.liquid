<section
  id="{{ section_uid }}"
  class="bs"
  data-section-id="{{ section.id }}"
  data-section-type="best-sellers"
>
  <div class="bs__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="bs__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ shop_all_url }}" class="bs__link">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  {%- if section.settings.subheading != blank -%}
    <p class="bs__subtitle">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div class="bs__grid">
    {%- if product_count > 0 -%}
      {%- for p in product_source limit: products_limit -%}
        {%- liquid
          assign variant = p.selected_or_first_available_variant
          assign product_title = p.title | escape

          # Badge: metafield > sale badge > default badge
          assign badge_parts = section.settings.badge_metafield | split: '.'
          assign badge_text = p.metafields[badge_parts[0]][badge_parts[1]] | metafield_text
          if badge_text == blank
            if p.compare_at_price > p.price and section.settings.sale_badge != blank
              assign badge_text = section.settings.sale_badge
            else
              assign badge_text = section.settings.default_badge
            endif
          endif

          # Use case: metafield > product type
          assign use_parts = section.settings.use_metafield | split: '.'
          assign use_text = p.metafields[use_parts[0]][use_parts[1]] | metafield_text
          if use_text == blank
            assign use_text = p.type
          endif

          # Chip
          assign chip_parts = section.settings.chip_metafield | split: '.'
          assign chip_text = p.metafields[chip_parts[0]][chip_parts[1]] | metafield_text

          # Rating (Shopify standard reviews metafields)
          assign rating_value = p.metafields.reviews.rating.value.rating
          assign rating_count = p.metafields.reviews.rating_count.value

          # Price
          if settings.currency_code_enable
            assign price_text = p.price | money_with_currency
          else
            assign price_text = p.price | money
          endif

          # Specs: check if at least one has a value
          assign has_specs = false
          for i in (1..3)
            assign spec_key_name = 'spec_' | append: i | append: '_metafield'
            assign spec_parts = section.settings[spec_key_name] | split: '.'
            assign spec_check = p.metafields[spec_parts[0]][spec_parts[1]] | metafield_text
            if spec_check != blank
              assign has_specs = true
            endif
          endfor
        -%}

        <article class="bs-card">
          <a href="{{ p.url }}" class="bs-card__link" tabindex="-1" aria-hidden="true"></a>

          <div class="bs-card__media">
            {%- if badge_text != blank -%}
              <span class="bs-card__badge">{{ badge_text }}</span>
            {%- endif -%}

            {%- if p.featured_media != blank -%}
              {%- assign image_alt = p.featured_media.alt | default: p.title | escape -%}
              {{
                p.featured_media
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 800',
                  sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 50vw, 100vw',
                  class: 'bs-card__img',
                  alt: image_alt
              }}
            {%- else -%}
              <span class="bs-card__media-text">[Product photo: {{ product_title }}]</span>
            {%- endif -%}
          </div>

          <div class="bs-card__body">
            {%- if section.settings.show_rating and rating_value != blank -%}
              <div class="bs-card__rating">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="{{ section.settings.color_button_bg }}" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"></path></svg>
                <b>{{ rating_value | round: 1 }}</b>
                {%- if rating_count != blank -%}
                  <span class="bs-card__rating-count">({{ rating_count }} {{ section.settings.reviews_label }})</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <h3 class="bs-card__title asd">{{ p.title }}</h3>


            {% if p.metafields.description.oneLiner != blank %}
              <div class="bs-card__use">
                {{ p.metafields.description.oneLiner.value }}
              </div>
            {% endif %}


            {%- if has_specs -%}
              <div class="bs-card__specs">
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign spec_label_name = 'spec_' | append: i | append: '_label'
                    assign spec_key_name = 'spec_' | append: i | append: '_metafield'
                    assign spec_parts = section.settings[spec_key_name] | split: '.'
                    assign spec_value = p.metafields[spec_parts[0]][spec_parts[1]] | metafield_text
                    if spec_parts[1] contains 'beam' and spec_value != blank
                      capture spec_value
                        render 'beam-distance', value: spec_value, format: 'm'
                      endcapture
                    elsif spec_parts[1] contains 'lumen' and spec_value != blank
                      capture spec_value
                        render 'spec-lumens', value: spec_value
                      endcapture
                    endif
                  -%}
                  {%- if spec_value != blank -%}
                    <div class="bs-card__spec">
                      <div class="bs-card__spec-label">{{ section.settings[spec_label_name] }}</div>
                      <div class="bs-card__spec-value">{{ spec_value }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if chip_text != blank -%}
              <div class="bs-card__chip">{{ chip_text }}</div>
            {%- endif -%}

            <product-form class="bs-card__bottom" data-product-form>
              <span class="bs-card__price">{{ price_text }}</span>

              {%- form 'product', p, id: 'BestSellersForm-{{ section.id }}-{{ p.id }}', class: 'bs-card__form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button
                  type="submit"
                  name="add"
                  class="bs-card__btn"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {%- if variant.available -%}
                    {{ section.settings.button_label }}
                  {%- else -%}
                    {{ section.settings.sold_out_label }}
                  {%- endif -%}
                </button>
              {%- endform -%}

              <div class="bs-card__errors" data-cart-errors-container></div>
            </product-form>

            {%- if section.settings.details_label != blank -%}
              <a href="{{ p.url }}" class="bs-card__details">{{ section.settings.details_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Placeholder cards shown until a collection is selected {%- endcomment -%}
      {%- for i in (1..4) -%}
        <article class="bs-card">
          <div class="bs-card__media">
            {%- if section.settings.default_badge != blank -%}
              <span class="bs-card__badge">{{ section.settings.default_badge }}</span>
            {%- endif -%}
            {%- assign placeholder_name = 'product-' | append: i -%}
            {{ placeholder_name | placeholder_svg_tag: 'bs-card__placeholder' }}
          </div>
          <div class="bs-card__body">
            <h3 class="bs-card__title">Product name</h3>
            <div class="bs-card__use">Select a collection in the theme editor</div>
            <div class="bs-card__specs">
              <div class="bs-card__spec"><div class="bs-card__spec-label">{{ section.settings.spec_1_label }}</div><div class="bs-card__spec-value">—</div></div>
              <div class="bs-card__spec"><div class="bs-card__spec-label">{{ section.settings.spec_2_label }}</div><div class="bs-card__spec-value">—</div></div>
              <div class="bs-card__spec"><div class="bs-card__spec-label">{{ section.settings.spec_3_label }}</div><div class="bs-card__spec-value">—</div></div>
            </div>
            <div class="bs-card__bottom">
              <span class="bs-card__price">{{ 0 | money }}</span>
              <button type="button" class="bs-card__btn" disabled>{{ section.settings.button_label }}</button>
            </div>
            {%- if section.settings.details_label != blank -%}
              <a href="#" class="bs-card__details">{{ section.settings.details_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best sellers",
  "tag": "div",
  "class": "section-best-sellers",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ranked by verified reviews. In stock and ready to ship."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all best sellers →"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link",
      "info": "Leave empty to link to the selected collection"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 12,
      "info": "Pick products manually. If any are selected, they are shown instead of the collection."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_metafield",
      "label": "Badge metafield",
      "default": "custom.badge",
      "info": "Format: namespace.key. Used first if the product has a value."
    },
    {
      "type": "text",
      "id": "sale_badge",
      "label": "Sale badge text",
      "default": "Sale",
      "info": "Shown when the product has a compare-at price"
    },
    {
      "type": "text",
      "id": "default_badge",
      "label": "Default badge text",
      "info": "Shown when no metafield or sale badge applies. Leave empty to hide."
    },
    {
      "type": "header",
      "content": "Rating"
