    "section_image_with_text_C4E8mz": {
      "type": "section-image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "title": "<p><strong>Emergency Light</strong></p>",
            "size": 100,
            "text_position": "left",
            "heading_highlight_type": "circle",
            "highlight_color": "#d43747",
            "highlight_text_color": "#000000",
            "spacing_bottom": 12
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>This application turns your flashlight into an emergency light: When the power goes out and your Ledlenser is on its charging station, it turns on automatically. The light thus helps you to orient yourself, and you can then find the fuse box, for example.</p>",
            "size": 100,
            "text_position": "left",
            "spacing_bottom": 12
          }
        }
      },
      "block_order": [
