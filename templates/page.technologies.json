    "cdb3be2a-9d5e-47f0-9431-04f739f3c7cc": {
      "type": "section-image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "title": "<p><strong>Flex Sealing Technology</strong></p>",
            "size": 100,
            "text_position": "left",
            "heading_highlight_type": "circle",
            "highlight_color": "#d43747",
            "highlight_text_color": "#000000",
            "spacing_bottom": 12
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>A protective inner sleeve means all moving parts are covered. The flex seal is 100% dust and watertight, even when adjusting focus, giving our new range ratings of up to IP67 and IP68.</p>",
            "size": 100,
            "text_position": "left",
            "spacing_bottom": 12
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ],
