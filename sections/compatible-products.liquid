{%- comment -%}
  Compatible products: on a product page, shows the products that work with
  the product being viewed (e.g. the lights a powerbank can charge).

  Data: product metafield custom.compatible_products (type: List of products).
  The team picks the compatible products per item in Shopify admin:
    Products > [product] > Metafields > Compatible products

  The section renders nothing when the metafield is empty, so it can stay on
  the product template for every product.

  Cards: snippets/product-card-bs.liquid (same card as the collection grid).
  Styles: assets/style.css (.compat__*) + assets/component-bs-card.css.
{%- endcomment -%}

{%- liquid
  assign section_uid = 'CompatibleProducts-' | append: section.id
  assign compatible = product.metafields.custom.compatible_products.value
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading

  assign item_count = 0
  if compatible != blank
    for item in compatible
      if item.id == product.id
        continue
      endif
      if section.settings.hide_sold_out and item.available == false
        continue
      endif
      if item_count >= section.settings.limit
        break
      endif
      assign item_count = item_count | plus: 1
    endfor
  endif
-%}

{%- if item_count > 0 -%}
  {{ 'component-bs-card.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    #{{ section_uid }} {
      background: {{ section.settings.color_bg }};
      color: {{ section.settings.color_text }};
    }
    #{{ section_uid }} .compat__inner {
      max-width: 1408px;
      margin: 0 auto;
      padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    }
    @media (max-width: 749px) {
      #{{ section_uid }} .compat__inner {
        padding: {{ section.settings.padding_top | times: 0.7 | round }}px 16px {{ section.settings.padding_bottom | times: 0.7 | round }}px;
      }
    }
  {%- endstyle -%}

  <section id="{{ section_uid }}" class="compat{% if item_count <= 3 %} compat--few{% endif %}" aria-labelledby="{{ section_uid }}-title">
    <div class="compat__inner">
      <div class="compat__head">
        <div class="compat__head-text">
          {%- if heading != blank -%}
            <h2 id="{{ section_uid }}-title" class="compat__title">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if subheading != blank -%}
            {%- assign product_title_escaped = product.title | escape -%}
            <p class="compat__sub">{{ subheading | escape | replace: '[product]', product_title_escaped }}</p>
          {%- endif -%}
        </div>

        {%- if item_count > 1 -%}
          <div class="compat__nav">
            <button type="button" class="compat__arrow" data-compat-prev aria-label="Previous compatible products" aria-controls="{{ section_uid }}-track">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <button type="button" class="compat__arrow" data-compat-next aria-label="Next compatible products" aria-controls="{{ section_uid }}-track">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <div
        id="{{ section_uid }}-track"
        class="compat__track"
        data-compat-track
        role="region"
        aria-label="{{ heading | default: 'Compatible products' | escape }}"
        tabindex="0"
      >
        {%- assign rendered = 0 -%}
        {%- for item in compatible -%}
          {%- liquid
            if item.id == product.id
              continue
            endif
            if section.settings.hide_sold_out and item.available == false
              continue
            endif
            if rendered >= section.settings.limit
              break
            endif
            assign rendered = rendered | plus: 1
          -%}
          {%- render 'product-card-bs', product: item, columns: 4, columns_mobile: 2 -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('{{ section_uid }}');
      if (!root || root.dataset.compatReady) return;
      root.dataset.compatReady = '1';
      var track = root.querySelector('[data-compat-track]');
      var prev = root.querySelector('[data-compat-prev]');
      var next = root.querySelector('[data-compat-next]');
      if (!track || !prev || !next) return;

      function step() {
        var card = track.querySelector('.bs-collection-item');
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        var cardW = card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
        return Math.max(cardW, Math.floor(track.clientWidth / cardW) * cardW);
      }
      function update() {
        var atStart = track.scrollLeft <= 2;
        var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
        prev.disabled = atStart;
        next.disabled = atEnd;
        root.classList.toggle('compat--no-scroll', atStart && atEnd);
      }
      prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();

      var drag = null;
      var suppressClick = false;
      track.addEventListener('pointerdown', function (e) {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        if (e.target.closest('button, input, select, textarea, label')) return;
        drag = { x: e.clientX, left: track.scrollLeft, moved: false, id: e.pointerId };
      });
      track.addEventListener('pointermove', function (e) {
        if (!drag || e.pointerId !== drag.id) return;
        var dx = e.clientX - drag.x;
        if (!drag.moved) {
          if (Math.abs(dx) < 5) return;
          drag.moved = true;
          track.classList.add('is-dragging');
          try { track.setPointerCapture(drag.id); } catch (err) {}
        }
        e.preventDefault();
        track.scrollLeft = drag.left - dx;
      });
      function endDrag(e) {
        if (!drag || (e && e.pointerId !== drag.id)) return;
        if (drag.moved) {
          suppressClick = true;
          setTimeout(function () { suppressClick = false; }, 0);
          var left = track.scrollLeft;
          track.classList.remove('is-dragging');
          track.scrollLeft = left;
        }
        drag = null;
      }
      track.addEventListener('pointerup', endDrag);
      track.addEventListener('pointercancel', endDrag);
      track.addEventListener('lostpointercapture', endDrag);
      track.addEventListener('click', function (e) {
        if (suppressClick) { e.preventDefault(); e.stopPropagation(); suppressClick = false; }
      }, true);
      track.addEventListener('dragstart', function (e) { e.preventDefault(); });
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="compat compat--empty" style="max-width:1320px;margin:0 auto;padding:24px;">
    <p style="margin:0;padding:16px;border:1px dashed #bbb;font-size:14px;color:#666;">
      <strong>Compatible products:</strong> nothing to show for {{ product.title | escape }}.
      In Shopify admin, open this product and choose items in its
      "Compatible products" metafield (custom.compatible_products).
      This note is only visible in the theme editor.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Compatible products",
  "class": "section-compatible-products",
  "settings": [
    {
      "type": "paragraph",
      "content": "Products come from each product's 'Compatible products' metafield (custom.compatible_products, List of products), set in Shopify admin on the product. The section is hidden on products where it is empty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compatible products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Products that work with the [product]",
      "info": "[product] is replaced with the product title. Leave empty to hide."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold out products",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#0a0a0a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Compatible products"
    }
  ]
}
{% endschema %}
