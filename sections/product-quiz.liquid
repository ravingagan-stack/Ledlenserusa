{%- comment -%} Ported from the live theme, which loaded jQuery and these styles site-wide {%- endcomment -%}
{%- render 'stylesheet', name: 'section-product-quiz.css' -%}
<script
  src="https://code.jquery.com/jquery-3.7.1.min.js"
  integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
  crossorigin="anonymous"></script>

<div class="product-quiz--main">
  <div class="product-quiz--header">
    <button class="quiz-header--left btn--back" style="opacity: 0;">
      {%- render 'icon-quiz-back' -%}
    </button>
    <div class="quiz-header--center">
      <p>THE BASICS 1/6</p>
    </div>
    <button class="quiz-header--right btn--exit">
      {%- render 'icon-quiz-exit' -%}
    </button>
  </div>

  <div class="quiz--step">
    {%- liquid
      for block in section.blocks
        case block.type
          when 'category_selector'
            render 'quiz-category-selector', block: block
          when 'multi_choice_selector'
            render 'quiz-multi-choice-selector', block: block, class: 'hide'
          when 'icon_selector'
            render 'quiz-icon-selector', block: block, class: 'hide'
          when 'range_selector'
            render 'quiz-range-selector', block: block, class: 'hide'
          when 'bonus_selector'
            render 'quiz-bonus-selector', block: block, class: 'hide'
          when 'block_selector'
            render 'quiz-block-selector', block: block, class: 'hide'
        endcase
      endfor
    -%}
  </div>
</div>

{% render 'quiz-loading', messages: section.settings.loading_messages, class: 'hide' %}

<script
  type="text/javascript"
>
  let currentStep = 1
  let skippedSteps = []

  window.addEventListener("load", () => {
    $('.btn--next').on('click', e => {
      const category = $("input[name='category']:checked").val()
      navigateNextStep(category)
    })

    $('.btn--back').on('click', () => {
      const category = $("input[name='category']:checked").val()
      navigatePreviousStep(category)
    })

    $('.btn--skip').on('click', () => {
      const category = $("input[name='category']:checked").val()
      navigateNextStep(category, true)
    })

    $('.quiz--step-option').on('click', e => {
      const category = $("input[name='category']:checked").val()
      const step = e.currentTarget.dataset.step
      const type = e.currentTarget.dataset.type

      validateCurrentStep(category, step, type)
    })

    $('.btn--filter').on('click', () => {
      skippedSteps = Array.from(new Set(skippedSteps.concat([7,8,9,10])))

      filterProducts()
    })

    $('.btn--exit').on('click', () => {
      window.location.href = '/'
    })
  })

  const validateCurrentStep = (category, step, type) => {
    const dom = parseInt(step) === 1 ? $(`.quiz--step-${step}`) : $(`.quiz--step-${step}[data-category=${category}]`)
    const btn = dom.find('.btn--next')

    if (type === 'multi-choice-selector') {
      if (dom.find('input:checkbox:checked').length) {
        btn.attr('disabled', false)
      } else {
        btn.attr('disabled', true)
      }
    }

    if (type === 'block-selector' || type === 'icon-selector' || type === 'category-selector') {
      if (dom.find('input:radio:checked').length) {
        btn.attr('disabled', false)
      } else {
        btn.attr('disabled', true)
      }
    }
  }

  const navigatePreviousStep = (category) => {
    if (currentStep === 1) {
      history.back()
      return
    }

    for (let step = 10; step >= 1; step--) {
      const selector = step === 1 ? `.quiz--step-${step}` : `.quiz--step-${step}[data-category=${category}]`
      const conditionTags = $(selector).data('condition-tags')
      let shouldSkip = false
  
      if (conditionTags) {
        const selectedTags = getSelectedOptionHandles(step)
        const containedTags = conditionTags.split(',').filter(tag => selectedTags.includes(tag))
        if (containedTags.length !== conditionTags.split(',').length) {
          shouldSkip = true
        }
      }

      if (step < currentStep && $(selector).length) {
        if (shouldSkip) {
          skippedSteps.push(step)
          const set = new Set(skippedSteps)
          skippedSteps = Array.from(set)
          continue
        } else {
          $(`.quiz--step-${currentStep}`).fadeOut(300, () => {
            $(selector).fadeIn()
          })
          if (skippedSteps.includes(step)) {
            skippedSteps = skippedSteps.filter(st => st !== step)
          }
          currentStep = step
          if (currentStep === 1) {
            $('.btn--back').css('opacity', 0)
          }
          if (currentStep > 6) {
            $(`.quiz-header--center`).html(`<p>BONUS ROUND ${currentStep - 6}/4</p>`)
          } else {
            $(`.quiz-header--center`).html(`<p>THE BASICS ${currentStep}/6</p>`)
          }
          break
        }
      }
    }
  }

  const navigateNextStep = (category, isSkip = false) => {
    if (currentStep === 10) {
      filterProducts()
    }

    for (let step = 1; step <= 10; step++) {
      const selector = `.quiz--step-${step}[data-category=${category}]`
      const conditionTags = $(selector).data('condition-tags')
      let shouldSkip = false

      if (conditionTags) {
        const selectedTags = getSelectedOptionHandles(step)
        const containedTags = conditionTags.split(',').filter(tag => selectedTags.includes(tag))
        if (containedTags.length !== conditionTags.split(',').length) {
          shouldSkip = true
        }
      }

      if (step > currentStep && $(selector).length) {
        if (shouldSkip) {
          skippedSteps.push(step)
          const set = new Set(skippedSteps)
          skippedSteps = Array.from(set)
          continue
        } else {
          $(`.quiz--step-${currentStep}`).fadeOut(300, () => {
            $(selector).fadeIn()
          })
          if (isSkip) {
            skippedSteps.push(currentStep)
            const set = new Set(skippedSteps)
            skippedSteps = Array.from(set)
          }
          currentStep = step
          if (currentStep > 1) {
            $('.btn--back').css('opacity', 1)
          }
          if (currentStep > 6) {
            $(`.quiz-header--center`).html(`<p>BONUS ROUND ${currentStep - 6}/4</p>`)
          } else {
            $(`.quiz-header--center`).html(`<p><p>THE BASICS ${currentStep}/6</p>`)
          }
          break
        }
      }
    }
  }

  const filterProducts = () => {
    $(`.quiz--step-${currentStep}`).fadeOut(300, () => {
      $(`.quiz--step-loading`).fadeIn(300, () => {
        $(`.quiz--loading--message-1`).fadeOut(1500, () => {
          $(`.quiz--loading--message-2`).fadeIn(1000, () => {
            $(`.quiz--loading--message-2`).fadeOut(1500, () => {
              $(`.quiz--loading--message-3`).fadeIn(1500, () => {
                navigateToCollection()
              })
            })
          })
        })
      })
    })
  }

  const handleize = (str) => {
    return str.toLowerCase().replace(/[^a-z0-9_]+/g, '-').replace(/-$/, '').replace(/^-/, '')
  }

  const getSelectedOptionHandles = (endStep) => {
    const categoryDom = $("input[name='category']:checked")
    const category = categoryDom.val()
    let filter = []

    for (let step = 0; step <= endStep; step++) {
      if (!skippedSteps.includes(step)) {

        const selector = `.quiz--step-${step}[data-category=${category}]`
        const type = $(selector).data('type')
        const tagPrefix = $(selector).data('tag-prefix')

        if ($(selector).length && type) {
          if (type === 'block-selector' || type === 'icon-selector') {
            if (tagPrefix) {
              filter.push(`${tagPrefix}-${$(selector).find("input[type='radio']:checked").val()}`)
            } else {
              filter.push($(selector).find("input[type='radio']:checked").val())
            }
          }
          if (type === 'multi-choice-selector') {
            $(selector).find("input:checkbox:checked").each((index, element) => {
              if (tagPrefix) {
                filter.push(`${tagPrefix}-${$(element).val()}`)
              } else {
                filter.push($(element).val())
              }
            })
          }
          if (type === 'range-selector') {
            if (tagPrefix) {
              filter.push(`${tagPrefix}-${$(selector).find('.range-value').data('val')}`)
            } else {
              filter.push($(selector).find('.range-value').data('val'))
            }
          }
        }
      }
    }
    filter = filter.map(str => handleize(str))

    return filter
  }

  const navigateToCollection = () => {
    const categoryDom = $("input[name='category']:checked")
    const collection = categoryDom.data('handle')
    let url = `https://${document.domain}/collections/${collection}/`
    const filter = getSelectedOptionHandles(10)

    window.location.href = `${url}${filter.join('+')}`
  }
</script>

<script
  type="text/javascript"
>
  window.addEventListener("load", () => {
    $('.quiz--range-slider').each((index, element) => {
      const $rangeSlider  = $(element)
      const $rangeOutput  = $rangeSlider.parent().find('.range-value')
      const $rangeItems   = $rangeSlider.parent().parent().find('.quiz--range-items-wrapper')
      const $rangeImage   = $rangeSlider.parent().parent().find('.quiz--product_slide--main')
      const $rangeDetails = $rangeSlider.parent().parent().find('.quiz--step3_details')

      setValue($rangeSlider, $rangeOutput, $rangeItems, $rangeImage, $rangeDetails)
      $rangeSlider.on('input', () => {
        setValue($rangeSlider, $rangeOutput, $rangeItems, $rangeImage, $rangeDetails)
      })
    })
  })

  const setValue = ($rangeSlider, $rangeOutput, $rangeItems, $rangeImage, $rangeDetails) => {
    const unit = $rangeSlider.attr('unit')
    const min = parseInt($rangeSlider.attr('min'))
    const max = parseInt($rangeSlider.attr('max'))
    const val = parseInt($rangeSlider.val())
    const cal = Number( (val - min) * 100 / (max - min) )
    const newPosition = 10 - (cal * 0.2)
    const style = `calc(${cal}% + (${newPosition}px))`

    $rangeOutput.html(`<span>${val} ${unit}</span>`)
    $rangeOutput.data('val', val)
    $rangeSlider.css('--value', style)
    // $rangeOutput.css('left', style)

    $rangeItems.children().each((i, obj) => {
      const range = parseInt($(obj).data('range'))
      const image = $(obj).data('image')
      const title = $(obj).data('title')
      const description = $(obj).data('description')

      if (range === val) {
        $rangeImage.find('img').attr('src', `https://${image}`)
        $rangeDetails.html(`<span class="step3_details--title">${title}</span><span class="step3_details--text">${description}</span>`)
      }
    })
  }
</script>

