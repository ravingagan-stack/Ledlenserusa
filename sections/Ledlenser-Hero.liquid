<section class="ll-hero hero-mmain">
  <div class="ll-hero-main">
    <div class="ll-hero-content">
      <div class="ll-hero-eyebrow">
        {{ section.settings.eyebrow }}
      </div>

      <h1 class="ll-hero-title">
        {{ section.settings.heading_line_1 }}<br>
        {{ section.settings.heading_line_2 }}<br>
        <span>{{ section.settings.heading_line_3 }}</span>
      </h1>

      <p class="ll-hero-description">
        {{ section.settings.description }}
      </p>

      <div class="ll-hero-buttons">
        <a href="{{ section.settings.button_1_link }}" class="ll-hero-button ll-hero-button-primary">
          {{ section.settings.button_1_text }}
        </a>

        <a href="{{ section.settings.button_2_link }}" class="ll-hero-button ll-hero-button-secondary">
          {{ section.settings.button_2_text }}
        </a>
      </div>

      <a href="{{ section.settings.finder_link }}" class="ll-hero-finder">
        {{ section.settings.finder_text }}
      </a>
    </div>

    <div class="ll-hero-visual">
     <svg viewBox="0 0 640 460" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Animation: a Ledlenser P7R beam focusing from a wide flood to a long-range spot on a distant tree line" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: block">
<defs>
<linearGradient id="llSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#050505"></stop><stop offset="1" stop-color="#16161A"></stop></linearGradient>
<linearGradient id="llBeam" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#FFFFFF" stop-opacity="0.95"></stop><stop offset="0.6" stop-color="#F4F6FF" stop-opacity="0.35"></stop><stop offset="1" stop-color="#F4F6FF" stop-opacity="0"></stop></linearGradient>
<linearGradient id="llSpotBeam" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#FFFFFF" stop-opacity="1"></stop><stop offset="1" stop-color="#FFFFFF" stop-opacity="0.55"></stop></linearGradient>
<radialGradient id="llGlow"><stop offset="0" stop-color="#FFFFFF" stop-opacity="0.95"></stop><stop offset="0.45" stop-color="#EEF1FF" stop-opacity="0.45"></stop><stop offset="1" stop-color="#EEF1FF" stop-opacity="0"></stop></radialGradient>
<radialGradient id="llPoolG"><stop offset="0" stop-color="#FFFFFF" stop-opacity="0.5"></stop><stop offset="1" stop-color="#FFFFFF" stop-opacity="0"></stop></radialGradient>
<clipPath id="llRingClip"><rect x="124" y="281" width="12" height="38" rx="2"></rect></clipPath>
</defs>
<rect x="0" y="0" width="640" height="460" fill="url(#llSky)"></rect>
<circle class="ll-star" cx="72" cy="58" r="1.3" fill="#FFFFFF"></circle>
<circle class="ll-star2" cx="190" cy="34" r="1" fill="#FFFFFF"></circle>
<circle class="ll-star" cx="300" cy="82" r="1.1" fill="#FFFFFF"></circle>
<circle class="ll-star2" cx="420" cy="40" r="1.4" fill="#FFFFFF"></circle>
<circle class="ll-star" cx="530" cy="96" r="1" fill="#FFFFFF"></circle>
<circle class="ll-star2" cx="610" cy="52" r="1.2" fill="#FFFFFF"></circle>
<circle class="ll-star2" cx="250" cy="140" r="0.9" fill="#FFFFFF"></circle>
<path transform="translate(0 40)" d="M340 270 L352 252 L358 262 L368 236 L376 258 L384 244 L392 262 L402 226 L412 256 L420 242 L430 262 L440 218 L452 254 L460 238 L470 260 L482 214 L494 252 L502 236 L512 258 L524 206 L536 250 L546 232 L556 254 L568 198 L580 246 L590 228 L600 252 L612 210 L624 248 L632 232 L640 240 L640 300 L340 300 Z" fill="#060606"></path>
<path d="M0 326 Q 300 318 640 314 L640 460 L0 460 Z" fill="#0D0D0F"></path>
<ellipse class="ll-a ll-pool" cx="420" cy="388" rx="240" ry="58" fill="url(#llPoolG)" opacity="0.55"></ellipse>
<polygon class="ll-a ll-flood" points="151,288 640,150 640,450 151,312" fill="url(#llBeam)" opacity="0.5"></polygon>
<polygon class="ll-a ll-spot" points="151,295 600,297 600,303 151,305" fill="url(#llSpotBeam)"></polygon>
<ellipse class="ll-a ll-hit" cx="600" cy="300" rx="44" ry="34" fill="url(#llGlow)"></ellipse>
<g class="ll-a ll-eyes">
<circle cx="594" cy="293" r="1.8" fill="#FFE7A3"></circle>
<circle cx="605" cy="293" r="1.8" fill="#FFE7A3"></circle>
</g>
<g>
<!-- P7R: tail switch, gripped body tube, red Mode Select Ring, tapered neck, focus ring, finned head, lens -->
<rect x="12" y="294" width="6" height="12" rx="2" fill="#1A1A1D"></rect>
<rect x="17" y="288" width="14" height="24" rx="3" fill="#2E2E33" stroke="#45454C" stroke-width="1"></rect>
<rect x="31" y="290" width="60" height="20" fill="#26262A" stroke="#3A3A40" stroke-width="1"></rect>
<path d="M38 291 l6 18 M46 291 l6 18 M54 291 l6 18 M62 291 l6 18 M70 291 l6 18 M78 291 l6 18" stroke="#3A3A40" stroke-width="1.6"></path>
<rect x="91" y="289" width="5" height="22" rx="1" fill="#E30613"></rect>
<path d="M96 290 L124 281 L124 319 L96 310 Z" fill="#2B2B30" stroke="#45454C" stroke-width="1"></path>
<rect x="124" y="281" width="12" height="38" rx="2" fill="#1A1A1D"></rect>
<g clip-path="url(#llRingClip)">
<g class="ll-a ll-ring">
<line x1="124" y1="283" x2="136" y2="283" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="287" x2="136" y2="287" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="291" x2="136" y2="291" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="295" x2="136" y2="295" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="299" x2="136" y2="299" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="303" x2="136" y2="303" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="307" x2="136" y2="307" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="311" x2="136" y2="311" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="315" x2="136" y2="315" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="319" x2="136" y2="319" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="323" x2="136" y2="323" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="327" x2="136" y2="327" stroke="#4A4A52" stroke-width="1.6"></line>
<line x1="124" y1="331" x2="136" y2="331" stroke="#4A4A52" stroke-width="1.6"></line>
</g>
</g>
<rect x="136" y="280" width="12" height="40" rx="3" fill="#303036" stroke="#45454C" stroke-width="1"></rect>
<path d="M140 282 v36 M144 282 v36" stroke="#45454C" stroke-width="1"></path>
<rect x="147" y="283" width="4" height="34" rx="1" fill="#FFFFFF"></rect>
</g>
</svg>

      <div class="ll-visual-top">
        <span class="ll-visual-label">
          {{ section.settings.visual_label }}
        </span>

        <div class="ll-visual-caption">
          <div class="ll-a ll-labA">
            <div class="ll-visual-word">
              {{ section.settings.flood_heading }}
            </div>
            <div class="ll-visual-description">
              {{ section.settings.flood_description }}
            </div>
          </div>

          <div class="ll-a ll-labB">
            <div class="ll-visual-word">
              {{ section.settings.spot_heading }}
            </div>
            <div class="ll-visual-description">
              {{ section.settings.spot_description }}
            </div>
          </div>
        </div>
      </div>

      <div class="ll-visual-bottom">
        <div class="ll-visual-steps">
          <span>{{ section.settings.step_1 }}</span>
          <span>{{ section.settings.step_2 }}</span>
          <span>{{ section.settings.step_3 }}</span>
        </div>

        <div class="ll-visual-track">
          <div class="ll-visual-track-line"></div>
          <div class="ll-a ll-dot"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="ll-proof">
    <div class="ll-proof-inner">
      <div class="ll-proof-item">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FF3B4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z"></path>
          <path d="M9 12l2 2 4-4"></path>
        </svg>
        <span><b>{{ section.settings.proof_1_bold }}</b> · {{ section.settings.proof_1_text }}</span>
      </div>

      <div class="ll-proof-item">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#FF3B4A" aria-hidden="true">
          <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"></path>
        </svg>
        <span><b>{{ section.settings.proof_2_bold }}</b> · {{ section.settings.proof_2_text }}</span>
      </div>

      <div class="ll-proof-item">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FF3B4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"></path>
          <circle cx="7" cy="18" r="1.6"></circle>
          <circle cx="17" cy="18" r="1.6"></circle>
        </svg>
        <span><b>{{ section.settings.proof_3_bold }}</b> · {{ section.settings.proof_3_text }}</span>
      </div>

      <div class="ll-proof-item">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FF3B4A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12a8 8 0 0 1 16 0v5a2 2 0 0 1-2 2h-2v-6h4M4 13h4v6H6a2 2 0 0 1-2-2z"></path>
        </svg>
        <span><b>{{ section.settings.proof_4_bold }}</b> · {{ section.settings.proof_4_text }}</span>
      </div>
    </div>
  </div>
</section>


<style>
.hero-mmain .ll-proof {
    display: none;
}
.hero-mmain .ll-hero-main {
    border-bottom: 1px solid #2A2A2A;
}
</style>


{% schema %}
