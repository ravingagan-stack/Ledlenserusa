<section
  id="ll-bundles-{{ section.id }}"
  class="ll-bundles"
  aria-label="{{ section.settings.heading | default: 'Bundles and kits' | escape }}"
>
  <div class="ll-bundles__inner">

    <div class="ll-bundles__header">
      {% if section.settings.heading != blank %}
        <h2 class="ll-bundles__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.view_all_link != blank %}
        <a
          href="{{ section.settings.view_all_link }}"
          class="ll-bundles__link"
        >
          {{ section.settings.view_all_text | default: 'View all' | escape }} &rarr;
        </a>
      {% endif %}
    </div>

    {% if section.settings.subheading != blank %}
      <p class="ll-bundles__sub">{{ section.settings.subheading | escape }}</p>
    {% endif %}

    {%- if mode == 'collection' -%}
      {%- comment -%} COLLECTION MODE {%- endcomment -%}
      {%- assign coll = collections[section.settings.collection] -%}

      {%- if coll != blank and coll.products.size > 0 -%}

        <div class="ll-bundles__slider swiper">

          <div class="ll-bundles__track swiper-wrapper" role="list">

            {%- for product in coll.products limit: limit -%}

              <a
                href="{{ product.url }}"
                class="ll-bundles__card swiper-slide"
                role="listitem"
              >
                <div class="ll-bundles__img">
                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '200,400',
                        sizes: '120px',
                        alt: product.title | escape
                    }}
                  {% endif %}
                </div>

                <div class="ll-bundles__info">
                  {%- if product.compare_at_price > product.price -%}
                    {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                    <span class="ll-bundles__badge">Save {{ pct }}%</span>
                  {%- elsif section.settings.default_badge != blank -%}
                    <span class="ll-bundles__badge">{{ section.settings.default_badge | escape }}</span>
                  {%- endif -%}

                  <div class="ll-bundles__name">{{ product.title | escape }}</div>

                  <div class="ll-bundles__price">
                    <span class="ll-bundles__price-now">{{ product.price | money }}</span>
                    {% if product.compare_at_price > product.price %}
                      <s class="ll-bundles__price-was">{{ product.compare_at_price | money }}</s>
                    {% endif %}
                  </div>
                </div>
              </a>

            {%- endfor -%}

          </div>

          <!-- Overlay navigation arrows -->
          <button
            type="button"
            class="ll-bundles__arrow ll-bundles__prev"
            aria-label="Previous products"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <button
            type="button"
            class="ll-bundles__arrow ll-bundles__next"
            aria-label="Next products"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>

        </div>

        <!-- Pagination dots -->
        <div
          class="ll-bundles__pagination"
          aria-label="Product slider pagination"
        ></div>

      {%- else -%}
        <div class="ll-bundles__empty">
          Select a collection in the section settings, or add products manually.
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} MANUAL MODE — one block = one product {%- endcomment -%}
      {%- assign has_any = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}{%- assign has_any = true -%}{%- endif -%}
      {%- endfor -%}

      {%- if has_any -%}

        <div class="ll-bundles__slider swiper">

          <div class="ll-bundles__track swiper-wrapper" role="list">

            {%- for block in section.blocks -%}
              {%- assign product = block.settings.product -%}
              {%- if product == blank -%}{%- continue -%}{%- endif -%}

              <a
                href="{{ product.url }}"
                class="ll-bundles__card swiper-slide"
                role="listitem"
                {{ block.shopify_attributes }}
              >
                <div class="ll-bundles__img">
                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '200,400',
                        sizes: '120px',
                        alt: product.title | escape
                    }}
                  {% endif %}
                </div>

                <div class="ll-bundles__info">
                  {%- if product.compare_at_price > product.price -%}
                    {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                    <span class="ll-bundles__badge">Save {{ pct }}%</span>
                  {%- elsif section.settings.default_badge != blank -%}
                    <span class="ll-bundles__badge">{{ section.settings.default_badge | escape }}</span>
                  {%- endif -%}

                  <div class="ll-bundles__name">{{ product.title | escape }}</div>

                  <div class="ll-bundles__price">
                    <span class="ll-bundles__price-now">{{ product.price | money }}</span>
                    {% if product.compare_at_price > product.price %}
                      <s class="ll-bundles__price-was">{{ product.compare_at_price | money }}</s>
                    {% endif %}
                  </div>
                </div>
              </a>

            {%- endfor -%}

          </div>

          <!-- Overlay navigation arrows -->
          <button
            type="button"
            class="ll-bundles__arrow ll-bundles__prev"
            aria-label="Previous products"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <button
            type="button"
            class="ll-bundles__arrow ll-bundles__next"
            aria-label="Next products"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>

        </div>

        <!-- Pagination dots -->
        <div
          class="ll-bundles__pagination"
          aria-label="Product slider pagination"
        ></div>

      {%- else -%}
        <div class="ll-bundles__empty">
          Add a product block, or switch source mode to "Collection".
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var sectionId = 'll-bundles-{{ section.id }}';

  function initBundlesSlider() {
    var root = document.getElementById(sectionId);

    if (!root) return;

    var slider = root.querySelector('.ll-bundles__slider');

    if (!slider || slider.swiper) return;

    if (typeof window.Swiper === 'undefined') {
      console.warn(
        'Swiper.js is not loaded. Check the CDN script in theme.liquid.'
      );
      return;
    }

    var slides = slider.querySelectorAll('.swiper-slide');

    if (!slides.length) return;

    var prevButton = slider.querySelector('.ll-bundles__prev');
    var nextButton = slider.querySelector('.ll-bundles__next');
    var pagination = root.querySelector('.ll-bundles__pagination');

    new window.Swiper(slider, {
      slidesPerView: 1,
      slidesPerGroup: 1,
      spaceBetween: 16,
      speed: 450,
      loop: false,
      watchOverflow: true,
      grabCursor: true,
      observer: true,
      observeParents: true,

      navigation: {
        prevEl: prevButton,
        nextEl: nextButton
      },

      {% comment %} pagination: {
        el: pagination,
        clickable: true
      }, {% endcomment %}

      breakpoints: {
        0: {
          slidesPerView: 1,
          slidesPerGroup: 1,
          spaceBetween: 16
        },
        750: {
          slidesPerView: 2,
          slidesPerGroup: 1,
          spaceBetween: 16
        },
        950: {
          slidesPerView: 3,
          slidesPerGroup: 1,
          spaceBetween: 16
        }
      },

      on: {
        init: function () {
          updateNavigation(this);
        },
        resize: function () {
          updateNavigation(this);
        },
        breakpoint: function () {
          updateNavigation(this);
        }
      }
    });

    function updateNavigation(swiper) {
      var visibleCount = Number(swiper.params.slidesPerView) || 1;
      var hideArrows = swiper.slides.length <= visibleCount;

      if (prevButton) prevButton.hidden = hideArrows;
      if (nextButton) nextButton.hidden = hideArrows;
      if (pagination) pagination.hidden = hideArrows;
    }
  }

  function startSlider() {
    initBundlesSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startSlider);
  } else {
    startSlider();
  }

  document.addEventListener('shopify:section:load', function (event) {
    if (
      event.detail &&
      event.detail.sectionId === '{{ section.id }}'
    ) {
      initBundlesSlider();
    }
  });
})();
</script>
{% schema %}
{
  "name": "Bundles & Kits",
  "tag": "section",
  "class": "section-bundles",
  "settings": [
    { "type": "header", "content": "Content source" },
    {
      "type": "select",
      "id": "source_mode",
      "label": "Show products from",
      "options": [
        { "value": "manual",     "label": "Manual — add each product as a block" },
        { "value": "collection", "label": "Collection — auto-pull products" }
      ],
      "default": "manual",
      "info": "Manual = pick products one by one. Collection = auto-pull from a chosen collection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (only used in Collection mode)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Max products (Collection mode)",
      "min": 2, "max": 24, "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "default_badge",
      "label": "Fallback badge (Collection mode)",
      "info": "Shown when a product has no compare-at price."
    },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading",       "label": "Heading", },
    { "type": "text", "id": "subheading",    "label": "Subheading"},
    { "type": "text", "id": "view_all_text", "label": "View-all text" },
    { "type": "url",  "id": "view_all_link", "label": "View-all link" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color",     "label": "Background",       "default": "#F5F0EA" },
    { "type": "color", "id": "card_bg",      "label": "Card background",  "default": "#FFFFFF" },
    { "type": "color", "id": "img_bg",       "label": "Image tile bg",    "default": "#EFE6DC" },
    { "type": "color", "id": "border_color", "label": "Card border",      "default": "#DADADA" },
    { "type": "color", "id": "text_color",   "label": "Text",             "default": "#0A0A0A" },
    { "type": "color", "id": "muted_color",  "label": "Muted text",       "default": "#4A4A4A" },
    { "type": "color", "id": "accent_color", "label": "Accent (badge)",   "default": "#E30613" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product",
      "limit": 24,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles & Kits"
    }
  ]
}
{% endschema %} {% endcomment %}