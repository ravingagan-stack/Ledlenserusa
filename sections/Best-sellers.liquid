    left: 12px;
    z-index: 1;
    background: {{ section.settings.color_badge_bg }};
    color: {{ section.settings.color_badge_text }};
    font-size: 12px;
    font-weight: 700;
        font-family: Barlow, Helvetica Neue, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 9px;
  }

  #{{ section_uid }} .bs-card__media-text {
    font-size: 12px;
    color: {{ section.settings.color_placeholder_text }};
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  #{{ section_uid }} .bs-card__body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  #{{ section_uid }} .bs-card__rating {
    display: flex;
    align-items: center;
    gap: 6px;
        font-family: Barlow, Helvetica Neue, sans-serif;
    font-size: 14px;
        line-height: 17px;
  }

  #{{ section_uid }} .bs-card__rating-count {
    color: {{ section.settings.color_muted }};
  }

  #{{ section_uid }} .bs-card__title {
    margin: 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 26px;
    text-transform: uppercase;
    line-height: 1;
  }

  #{{ section_uid }} .bs-card__use {
    font-size: 14px;
    color: {{ section.settings.color_muted }};
        font-family: Barlow, Helvetica Neue, sans-serif;
        line-height:17px;
