<section class="light-needs-section">
  <div class="light-needs-header">
    <h2 class="light-needs-heading">
      {{ section.settings.heading }}
    </h2>

    <a href="{{ section.settings.quiz_link }}" class="light-needs-quiz">
      {{ section.settings.quiz_text }}
    </a>
  </div>

  <div class="light-needs-grid">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.card_link }}"
        class="light-needs-card"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.card_image != blank %}
          <img
            src="{{ block.settings.card_image | image_url: width: 600 }}"
            alt="{{ block.settings.title | escape }}"
            width="{{ block.settings.card_image.width }}"
            height="{{ block.settings.card_image.height }}"
            loading="lazy"
          >
        {% endif %}

        <span class="light-needs-img">
          {{ block.settings.img_text }}
        </span>

        <span class="light-needs-card-content">
          <span class="light-needs-card-title">
            {{ block.settings.title }}
          </span>

          <span class="light-needs-sub">
            {{ block.settings.sub }}
          </span>

          <span class="light-needs-pick">
            {{ section.settings.pick_label }} {{ block.settings.pick }} →
          </span>
        </span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Light Needs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What do you need light for?"
    },
    {
      "type": "text",
      "id": "quiz_text",
      "label": "Quiz Link Text",
      "default": "Take the Light Finder quiz →"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Quiz Link"
    },
    {
      "type": "text",
      "id": "pick_label",
      "label": "Top Pick Label",
      "default": "Top pick:"
    }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Need Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "img_text",
          "label": "Image Text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Work & Jobsite"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Description",
          "default": "Hands-free, hard-hat ready"
        },
        {
          "type": "text",
          "id": "pick",
          "label": "Top Pick",
          "default": "H19R"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Light Needs",
      "blocks": [
        {
          "type": "need",
          "settings": {
            "title": "Work & Jobsite",
            "sub": "Hands-free, hard-hat ready",
            "pick": "H19R"
          }
        },
        {
          "type": "need",
          "settings": {
            "title": "Hunting",
            "sub": "Red & green light, long throw",
            "pick": "HF8R Core RGB"
          }
        },
        {
          "type": "need",
          "settings": {
            "title": "Camping & Trail",
            "sub": "Light, long runtime",
            "pick": "MH10"
          }
        },
        {
          "type": "need",
          "settings": {
            "title": "Home & Car",
            "sub": "Glovebox and drawer ready",
            "pick": "P5R"
          }
        },
        {
          "type": "need",
          "settings": {
            "title": "Tactical & Duty",
            "sub": "Instant on, built tough",
            "pick": "TAC6R"
          }
        },
        {
          "type": "need",
          "settings": {
            "title": "Gifts Under $75",
            "sub": "Pocket lights and kits",
            "pick": "P4R"
          }
        }
      ]
    }
  ]
}
{% endschema %}