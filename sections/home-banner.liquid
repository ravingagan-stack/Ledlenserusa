{%- liquid
  assign section_uid = 'HomeBanner-' | append: section.id
  assign img_desktop = section.settings.image_desktop
  assign img_mobile = section.settings.image_mobile
  if img_desktop == blank
    assign img_desktop = img_mobile
  endif
  if img_mobile == blank
    assign img_mobile = img_desktop
  endif

  assign heading = section.settings.heading
  assign text = section.settings.text
  assign button_label = section.settings.button_label
  assign link = section.settings.link

  assign has_content = false
  if heading != blank or text != blank
    assign has_content = true
  endif
  if button_label != blank and link != blank
    assign has_content = true
  endif

  assign wrap_link = false
  if link != blank and button_label == blank
    assign wrap_link = true
  endif

  if section.settings.load_first
    assign loading = 'eager'
    assign priority = 'high'
  else
    assign loading = 'lazy'
    assign priority = 'auto'
  endif

  assign alt_text = img_desktop.alt | default: heading | escape
-%}

{%- style -%}
  #{{ section_uid }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 749px) {
    #{{ section_uid }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

<section
  id="{{ section_uid }}"
  class="hb{% if section.settings.full_width %} hb--full{% endif %}"
  style="--hb-text: {{ section.settings.color_text }}; --hb-btn-bg: {{ section.settings.color_button_bg }}; --hb-btn-text: {{ section.settings.color_button_text }}; --hb-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="hb__inner">
    {%- if wrap_link -%}<a class="hb__link" href="{{ link }}"{% if heading != blank %} aria-label="{{ heading | escape }}"{% endif %}>{%- endif -%}

    <div class="hb__media">
      {%- if img_desktop != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ img_mobile | image_url: width: 375 }} 375w, {{ img_mobile | image_url: width: 750 }} 750w, {{ img_mobile | image_url: width: 1100 }} 1100w"
            sizes="100vw"
            width="{{ img_mobile.width }}"
            height="{{ img_mobile.height }}"
          >
          {{
            img_desktop
            | image_url: width: 3200
            | image_tag:
              class: 'hb__img',
              alt: alt_text,
              loading: loading,
              fetchpriority: priority,
              sizes: '100vw',
              widths: '750, 1100, 1500, 1920, 2400, 3200'
          }}
        </picture>
      {%- else -%}
        <div class="hb__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'hb__placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    {%- if has_content -%}
      <div class="hb__content hb__content--{{ section.settings.position }} hb__content--align-{{ section.settings.alignment }}">
        <div class="hb__box">
          {%- if heading != blank -%}
            <h2 class="hb__heading">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if text != blank -%}
            <div class="hb__text">{{ text }}</div>
          {%- endif -%}
          {%- if button_label != blank and link != blank -%}
            <a class="hb__btn" href="{{ link }}">{{ button_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if wrap_link -%}</a>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hb__inner {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .hb--full .hb__inner {
    max-width: none;
    padding: 0;
  }
  .hb__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .hb__media {
    position: relative;
  }
  .hb__media picture,
  .hb__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hb__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--hb-overlay, 0);
    pointer-events: none;
  }
  .hb__placeholder {
    aspect-ratio: 16 / 6;
    background: #e9e9e9;
  }
  .hb__placeholder-svg {
    width: 100%;
    height: 100%;
    fill: #bdbdbd;
  }
  .hb__content {
    position: absolute;
    inset: 0;
    display: flex;
    padding: 48px;
    color: var(--hb-text);
    pointer-events: none;
  }
  .hb:not(.hb--full) .hb__content {
    left: 24px;
    right: 24px;
  }
  .hb__box {
    max-width: 560px;
    pointer-events: auto;
  }
  .hb__content--top-left { align-items: flex-start; justify-content: flex-start; }
  .hb__content--top-center { align-items: flex-start; justify-content: center; }
  .hb__content--middle-left { align-items: center; justify-content: flex-start; }
  .hb__content--middle-center { align-items: center; justify-content: center; }
  .hb__content--bottom-left { align-items: flex-end; justify-content: flex-start; }
  .hb__content--bottom-center { align-items: flex-end; justify-content: center; }
  .hb__content--align-left .hb__box { text-align: left; }
  .hb__content--align-center .hb__box { text-align: center; }
  .hb__heading {
    margin: 0 0 12px;
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-size: 52px;
    line-height: 1;
    text-transform: uppercase;
    color: inherit;
  }
  .hb__text {
    font-family: Barlow, 'Helvetica Neue', sans-serif;
    font-size: 18px;
    line-height: 1.5;
  }
  .hb__text p {
    margin: 0 0 8px;
  }
  .hb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 16px;
    padding: 0 28px;
    background: var(--hb-btn-bg);
    color: var(--hb-btn-text);
    font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: .04em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hb__btn:hover {
    opacity: .9;
  }
  .hb__link:focus-visible,
  .hb__btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  @media (max-width: 749px) {
    .hb__inner {
      padding: 0 16px;
    }
    .hb:not(.hb--full) .hb__content {
      left: 16px;
      right: 16px;
    }
    .hb__content {
      padding: 20px;
    }
    .hb__heading {
      font-size: 32px;
    }
    .hb__text {
      font-size: 15px;
    }
    .hb__btn {
      min-height: 42px;
      margin-top: 12px;
      padding: 0 20px;
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home banner",
  "tag": "div",
  "class": "section-home-banner",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Shown on screens wider than 749px. Displays at its own height."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Shown on screens up to 749px. Displays at its own height. Leave empty to use the desktop image."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "load_first",
      "label": "Load image first",
      "info": "Turn on when this banner is at the top of the page.",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave empty to make the whole banner clickable."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_button_bg",
      "label": "Button background",
      "default": "#e30613"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Home banner"
    }
  ]
}
{% endschema %}
