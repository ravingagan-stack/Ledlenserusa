<div
  class="quiz--step-{{ block.settings.step }} step-600 {{ class }} quiz--bg"
  style="--desktopimg: url({{ block.settings.bg_img | img_url: 'master' }}); --mobileimg: url({{ block.settings.mobile_img | img_url: 'master' }});"
  data-category="{{ block.settings.category }}"
  data-type="range-selector"
  data-tag-prefix="{{ block.settings.tag_prefix }}"
  data-condition-tags="{{ block.settings.display_condition_tags }}"
  data-image="{{ block.settings.bg_img | img_url: 'master' }}"
>
  {%- if block.settings.title != blank -%}
    <h2 class="quiz--step_h2">{{ block.settings.title }}</h2>
  {%- endif -%}

  <div class="quiz--product_main">
    <div class="quiz--step3-product">
      <div class="quiz--product_slide quiz--product_slide--main active">
        <img id="productselect_img" src="{{ block.settings.ch_1_icon | img_url: 'master' }}">
      </div>
    </div>
    <div class="range-value"></div>
    <input
      class="quiz--range-slider"
      type="range"
      value="{{ block.settings.ch_1_range }}"
      step="{{ block.settings.range_step }}"
      min="{{ block.settings.range_min }}"
      max="{{ block.settings.range_max }}"
      unit="{{ block.settings.range_unit }}"
      style="--value: calc(0% + (10px));"
    >
    <div class="quiz--step3_details">
      <span class="step3_details--title">{{ block.settings.ch_1_title }}</span>
      <span class="step3_details--text">{{ block.settings.ch_1_description }}</span>
    </div>
  </div>

  <div class="quiz--range-items-wrapper">
    {%- for i in (1..3) -%}
      {% capture range_id %}ch_{{ i }}_range{% endcapture %}
      {% capture image_id %}ch_{{ i }}_icon{% endcapture %}
      {% capture title_id %}ch_{{ i }}_title{% endcapture %}
      {% capture description_id %}ch_{{ i }}_description{% endcapture %}

      <div
        class="quiz--range-item"
        data-range="{{ block.settings[range_id] }}"
        data-image="{{ block.settings[image_id] | img_url: 'master' }}"
        data-title="{{ block.settings[title_id] }}"
        data-description="{{ block.settings[description_id] }}"
      ></div>
    {%- endfor -%}
  </div>

  {%- if block.settings.cta_label != blank -%}
    <button class="quiz--product-button btn--next">{{ block.settings.cta_label }}</button>
  {%- endif -%}
  {%- if block.settings.is_optional -%}
    <button class="button--text quiz--product-button btn--skip">I’M NOT SURE, SKIP</button>
  {%- endif -%}
</div>
