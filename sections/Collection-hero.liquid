{%- comment -%}
  Section: Collection hero (Headlamps style)
  File: sections/collection-hero-headlamps.liquid
{%- endcomment -%}

{%- if section.settings.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@800&display=swap" rel="stylesheet">
{%- endif -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank and collection
    assign heading = collection.title
  endif

  assign description = section.settings.description
  if description == blank and collection
    assign description = collection.description
  endif
-%}

<style>
  #chh {
    --chh-bg: #0A0A0A;
    --chh-red: #E30613;
    --chh-icon: #FF3B4A;
    --chh-white: #FFFFFF;
    --chh-text: #D0D0D0;
    --chh-muted: #C8C8C8;
    --chh-border: #555555;
    background: var(--chh-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: 'Barlow', sans-serif;
    color: var(--chh-text);
  }
  #chh * { box-sizing: border-box; }

  #chh .chh__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #chh .chh__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }
  #chh .chh__content { flex: 1 1 auto; min-width: 0; }

  /* Breadcrumb */
  #chh .chh__breadcrumb {
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    letter-spacing: 0;
    vertical-align: middle;
    color: #C8C8C8;
    margin: 0;
  }
  #chh .chh__breadcrumb a {
    color: #C8C8C8;
    text-decoration: underline;
    text-decoration-style: solid;
    text-decoration-thickness: 1px;
    text-underline-offset: 0;
    text-decoration-skip-ink: auto;
  }
  #chh .chh__breadcrumb a:hover { color: var(--chh-white); }

  /* Heading */
  #chh .chh__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-style: normal;
    font-size: 72px;
    line-height: 72px;
    letter-spacing: 0.72px;
    text-transform: uppercase;
    color: #fff;
    margin: 12px 0;
  }

  /* Description */
  #chh .chh__desc,
  #chh .chh__desc p {
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 27px;
    letter-spacing: 0;
    color: #D0D0D0;
    margin: 0;
    max-width: 480px;
  }

  /* Trust list */
  #chh .chh__trust {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 0 0 auto;
  }
  #chh .chh__trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 7.5px 0;
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 22.5px;
    color: #D0D0D0;
  }
  #chh .chh__trust-item svg { flex: 0 0 20px; width: 20px; height: 20px; }
  #chh .chh__trust-item strong {
    font-weight: 700;
    color: #fff;
  }
  #chh .chh__trust-item a {
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  #chh .chh__trust-item a:hover { color: #fff; }

  /* Filter pills */
  #chh .chh__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: {{ section.settings.pills_spacing }}px;
  }
  #chh .chh__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 16px;
    font-family: 'Barlow', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    color: #fff;
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--color-grey-33, #555555);
    white-space: nowrap;
    transition: border-color .15s ease, background-color .15s ease;
  }
  #chh .chh__pill:hover { border-color: #fff; }
  #chh .chh__pill.is-active {
    background: var(--color-red-46, #E30613);
    border-color: var(--color-red-46, #E30613);
    color: #fff;
  }
  #chh .chh__pill:focus-visible,
  #chh a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Responsive */
  @media (max-width: 989px) {
    #chh .chh__top { flex-direction: column; align-items: flex-start; gap: 24px; }
  }
  @media (max-width: 749px) {
    #chh .chh__title { font-size: 48px; line-height: 48px; letter-spacing: 0.48px; }
    #chh .chh__desc,
    #chh .chh__desc p { font-size: 16px; line-height: 24px; }
    #chh .chh__pills {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-left: -20px;
      margin-right: -20px;
      padding: 0 20px;
      scrollbar-width: none;
      margin-top: 32px;
    }
    #chh .chh__pills::-webkit-scrollbar { display: none; }
  }
</style>

<section id="chh" class="chh">
  <div class="chh__container">
    <div class="chh__top">
      <div class="chh__content">
        {%- if section.settings.show_breadcrumb -%}
          <nav class="chh__breadcrumb" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a> / {{ heading }}
          </nav>
        {%- endif -%}

        {%- if heading != blank -%}
          <h1 class="chh__title">{{ heading }}</h1>
        {%- endif -%}

        {%- if description != blank -%}
          <div class="chh__desc">{{ description }}</div>
        {%- endif -%}
      </div>

      {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
      {%- if trust_blocks.size > 0 -%}
        <ul class="chh__trust">
          {%- for block in trust_blocks -%}
            <li class="chh__trust-item" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M9.99996 2.5L15.8333 5V10C15.8333 13.75 13.3333 16.6667 9.99996 17.5C6.66663 16.6667 4.16663 13.75 4.16663 10V5L9.99996 2.5Z" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" stroke="#FF3B4A"/><path d="M7.5 10L9.16667 11.6667L12.5 8.33337" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" stroke="#FF3B4A"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M11.6667 13.3334V5.83337H2.5V13.3334H11.6667ZM11.6667 13.3334H17.5V10.8334L15 8.33337H11.6667V13.3334Z" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" stroke="#FF3B4A"/><path d="M7.16667 15C7.16667 15.7363 6.56971 16.3333 5.83333 16.3333C5.09695 16.3333 4.5 15.7363 4.5 15C4.5 14.2636 5.09695 13.6666 5.83333 13.6666C6.56971 13.6666 7.16667 14.2636 7.16667 15Z" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" stroke="#FF3B4A"/><path d="M15.5 15C15.5 15.7363 14.9031 16.3333 14.1667 16.3333C13.4303 16.3333 12.8334 15.7363 12.8334 15C12.8334 14.2636 13.4303 13.6666 14.1667 13.6666C14.9031 13.6666 15.5 14.2636 15.5 15Z" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" stroke="#FF3B4A"/></svg>
                {%- when 'headset' -%}
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.33337 10C3.33337 8.23193 4.03575 6.53624 5.286 5.286C6.53624 4.03575 8.23193 3.33337 10 3.33337C11.7682 3.33337 13.4638 4.03575 14.7141 5.286C15.9643 6.53624 16.6667 8.23193 16.6667 10V10.8334M16.6667 10.8334V14.1667C16.6667 14.6087 16.4911 15.0327 16.1786 15.3452C15.866 15.6578 15.4421 15.8334 15 15.8334H13.3334V10.8334H16.6667ZM3.33337 10.8334H6.66671V15.8334H5.00004C4.55801 15.8334 4.13409 15.6578 3.82153 15.3452C3.50897 15.0327 3.33337 14.6087 3.33337 14.1667V10.8334Z" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" stroke="#FF3B4A"/></svg>
              {%- endcase -%}
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- assign pill_blocks = section.blocks | where: 'type', 'pill' -%}
    {%- if pill_blocks.size > 0 -%}
      <nav class="chh__pills" aria-label="Filter headlamps">
        {%- for block in pill_blocks -%}
          {%- liquid
            assign is_active = false
            if block.settings.active
              assign is_active = true
            elsif block.settings.link != blank and block.settings.link == request.path
              assign is_active = true
            endif
          -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="chh__pill{% if is_active %} is-active{% endif %}"
            {% if is_active %}aria-current="page"{% endif %}
            {{ block.shopify_attributes }}
          >{{ block.settings.label }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection hero",
  "tag": "div",
  "class": "section-collection-hero",
  "settings": [
    { "type": "checkbox", "id": "load_fonts", "label": "Load Barlow fonts from Google Fonts", "default": true },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the collection title", "default": "Headlamps" },
    { "type": "richtext", "id": "description", "label": "Description", "info": "Leave empty to use the collection description", "default": "<p>Rechargeable, focusable headlamps for the jobsite, the trail and the hunt. Specs are shown in feet and hours so you can compare at a glance.</p>" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 960, "max": 1600, "step": 8, "unit": "px", "default": 1096 },
    { "type": "range", "id": "pills_spacing", "label": "Space above filter buttons", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (warranty)" },
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "headset", "label": "Headset (support)" }
          ],
          "default": "shield"
        },
        { "type": "inline_richtext", "id": "text", "label": "Text", "info": "Bold text shows in white. Links are underlined.", "default": "<strong>7-year warranty,</strong> no questions asked" }
      ]
    },
    {
      "type": "pill",
      "name": "Filter button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Work & jobsite" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "active", "label": "Always show as active (red)", "info": "Buttons also turn red automatically when their link matches the current page", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection hero",
      "blocks": [
        { "type": "trust", "settings": { "icon": "shield", "text": "<strong>7-year warranty,</strong> no questions asked" } },
        { "type": "trust", "settings": { "icon": "truck", "text": "<strong>Ships in 1–2 days</strong> from the US" } },
        { "type": "trust", "settings": { "icon": "headset", "text": "<strong>Not sure?</strong> <a href=\"/pages/contact\">Ask an expert</a> or <a href=\"/pages/light-finder\">take the Light Finder</a>" } },
        { "type": "pill", "settings": { "label": "All headlamps", "link": "/collections/headlamps", "active": true } },
        { "type": "pill", "settings": { "label": "Work & jobsite" } },
        { "type": "pill", "settings": { "label": "Hiking & camping" } },
        { "type": "pill", "settings": { "label": "Hands-free sensor" } },
        { "type": "pill", "settings": { "label": "Brightest" } },
        { "type": "pill", "settings": { "label": "Under $100" } },
        { "type": "pill", "settings": { "label": "Kits with powerbank" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["collection", "page", "index"] }
}
{% endschema %}
