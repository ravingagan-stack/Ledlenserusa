<div
  class="quiz--step-{{ block.settings.step }} step-600 {{ class }} quiz--bg"
  style="--desktopimg: url({{ block.settings.bg_img | img_url: 'master' }}); --mobileimg: url({{ block.settings.mobile_img | img_url: 'master' }});"
  data-category="{{ block.settings.category }}"
  data-type="multi-choice-selector"
  data-tag-prefix="{{ block.settings.tag_prefix }}"
  data-condition-tags="{{ block.settings.display_condition_tags }}"
  data-image="{{ block.settings.bg_img | img_url: 'master' }}"
>
  {%- if block.settings.title != blank -%}
    <h2 class="quiz--step_h2">{{ block.settings.title }}</h2>
  {%- endif -%}

  {%- if block.settings.sub_title != blank -%}
    <span class="quiz--step-span">{{ block.settings.sub_title }}</span>
  {%- endif -%}

  {%- if block.settings.options != blank -%}
    <div class="quiz--product_main quiz--product_select">
      {%- assign options = block.settings.options | split: ',' %}
      {%- for option in options -%}
        <label class="quiz--step-option" data-step="{{ block.settings.step }}" data-type="multi-choice-selector">
          <input type="checkbox" name="step-2" value="{{ option }}">
          <span>{{ option | replace: '_', '+' }}</span>
        </label>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if block.settings.cta_label != blank -%}
    <button class="quiz--product-button btn--next" disabled>
      {{ block.settings.cta_label }}
    </button>
  {%- endif -%}
  {%- if block.settings.is_optional -%}
    <button class="button--text quiz--product-button btn--skip">I’M NOT SURE, SKIP</button>
  {%- endif -%}
</div>
