<!doctype html>
<html class="no-touch page-loading" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'head' -%}

    {{ content_for_header }}
    <!-- Swiper CSS: shared by all sections -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    <!-- Swiper JavaScript: load once for the entire theme -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  </head>

  {%- liquid
    assign selected_color_scheme = settings.color_scheme | strip
    assign scheme_bg_color = settings.color_schemes[selected_color_scheme].settings.section_bg
    assign scheme_bg_color_brightness = scheme_bg_color | color_brightness | round

    capture body_classes
      echo 'template-' | append: template | replace: '.', ' ' | truncatewords: 1, '' | handle
      if customer
        echo ' customer-logged-in'
      endif
      if settings.show_rounded_corners
        echo ' body--rounded-corners'
      endif
      if settings.animations_enabled
        echo ' aos-initialized'
      endif
      if scheme_bg_color_brightness < 153
        echo ' palette--dark'
      else
        echo ' palette--light'
      endif
      echo ' no-outline'
    endcapture

    assign body_classes = body_classes | strip_newlines | strip
  -%}

  <body id="{{ page_title | handle }}" class="{{ body_classes }}">
    {%- render 'loading' -%}

    <a class="in-page-link skip-link" data-skip-content href="#MainContent">
      {{- 'general.accessibility.skip_to_content' | t -}}
    </a>

    <div class="header-group">
      {% sections 'group-header' %}
    </div>
    {% sections 'group-overlay' %}

    <main id="MainContent" class="main-content" data-main>
      {{ content_for_layout }}
    </main>

    {% sections 'group-footer' %}

    {%- comment -%} Photoswipe containers {%- endcomment -%}
    {%- render 'zoom-pswp', template_index: 0 -%}
    {%- render 'zoom-pswp', template_index: 1 -%}

    {%- if settings.show_scroll_to_top -%}
      <button
        type="button"
        class="btn btn--primary btn--solid btn--scroll-top"
        data-scroll-top-button
        aria-label="{{ 'general.accessibility.scroll_to_top' | t }}"
      >
        <hover-button></hover-button>
        {% render 'icon-select' %}
      </button>
    {%- endif -%}


<script>
  (function () {
    var bar = document.querySelector('.custom-announcement-bar');
    if (!bar) return;

    var items = Array.prototype.filter.call(bar.children, function (el) {
      return !el.classList.contains('separator');
    });
    if (items.length < 2) return;

    var mq = window.matchMedia('(max-width: 768px)');
    var delay = 3500;
    var index = 0;
    var timer = null;

    function show(next) {
      var current = items[index];
      current.classList.remove('is-active');
      current.classList.add('is-leaving');
      setTimeout(function () { current.classList.remove('is-leaving'); }, 400);

      index = next;
      items[index].classList.add('is-active');
    }

    function start() {
      if (timer) return;
      bar.classList.add('is-slider');
      index = 0;
      items.forEach(function (el) { el.classList.remove('is-active', 'is-leaving'); });
      items[0].classList.add('is-active');
      timer = setInterval(function () {
        show((index + 1) % items.length);
      }, delay);
    }

    function stop() {
      clearInterval(timer);
      timer = null;
      bar.classList.remove('is-slider');
      items.forEach(function (el) { el.classList.remove('is-active', 'is-leaving'); });
    }

    function check() {
      mq.matches ? start() : stop();
    }

    check();
    mq.addEventListener('change', check);
  })();
</script>
<script>
  (function () {
    function updateCartCount() {
      fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } })
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          document.querySelectorAll('.custom-cart-count').forEach(function (el) {
            el.textContent = cart.item_count;
          });
          document.querySelectorAll('.cart__toggle').forEach(function (el) {
            el.classList.toggle('cart__toggle--has-items', cart.item_count > 0);
          });
        })
        .catch(function () {});
    }

    // Theme cart events
    ['theme:cart:refresh', 'theme:cart:change', 'theme:cart:add', 'cart:refresh'].forEach(function (evt) {
      document.addEventListener(evt, updateCartCount);
    });

    // Fallback: catch any AJAX add / change / update / clear
    var originalFetch = window.fetch;
    window.fetch = function () {
      var url = arguments[0] && arguments[0].url ? arguments[0].url : String(arguments[0]);
      return originalFetch.apply(this, arguments).then(function (res) {
        if (/\/cart\/(add|change|update|clear)/.test(url)) {
          setTimeout(updateCartCount, 100);
        }
        return res;
      });
    };
  })();
</script>

<script>
document.addEventListener('click', function (e) {
  const toggle = e.target.closest('.search-popdown__toggle');
  const close = e.target.closest('.search-popdown__close');

  if (toggle) {
    setTimeout(function () {
      const search = document.querySelector('.search-popdown__main.new-search-compo');
      if (search) {
        search.classList.add('new-serch-pop');
      }
    }, 200);
  }

  if (close) {
    const search = document.querySelector('.search-popdown__main.new-search-compo');
    if (search) {
      search.classList.remove('new-serch-pop');
    }
  }
});
</script>


<script>
(function () {
  const originalAttach = Element.prototype.attachShadow;
  Element.prototype.attachShadow = function (init) {
    if (this.localName === 'shop-pay-wallet-button' || this.localName === 'gravity-button') {
      init = Object.assign({}, init, { mode: 'open' });
    }
    return originalAttach.call(this, init);
  };
})();

(function () {
  const CSS = `
    .gravity-button {
      background-color: #0A0A0A !important;   /* button color */
      color: #ffffff !important;              /* text color */
      border-radius: 0 !important;            /* optional */
      height:54px;
      font-family: Barlow Condensed;
font-weight: 700;
font-style: Bold;
font-size: 19px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0.76px;
text-align: center;
vertical-align: middle;
text-transform: uppercase;
    }
    .gravity-button:hover {
      background-color: #b8050f !important;   /* hover color */
    }

@media only screen and (max-width: 749px) {
      .gravity-button {
      background-color: #0A0A0A !important;   /* button color */
      color: #ffffff !important;              /* text color */
      border-radius: 0 !important;            /* optional */
      height:44px;
      }
}
@media only screen and (min-width: 750px) and (max-width: 989px) {
      .gravity-button {
      background-color: #0A0A0A !important;   /* button color */
      color: #ffffff !important;              /* text color */
      border-radius: 0 !important;            /* optional */
      }
}

  `;

  function styleShopButtons() {
    let done = false;
    document.querySelectorAll('shop-pay-wallet-button').forEach(function (wallet) {
      const gravity = wallet.shadowRoot && wallet.shadowRoot.querySelector('gravity-button');
      const root = gravity && gravity.shadowRoot;
      if (!root) return;
      if (!root.querySelector('#custom-shop-style')) {
        const style = document.createElement('style');
        style.id = 'custom-shop-style';
        style.textContent = CSS;
        root.appendChild(style);
      }
      done = true;
    });
    return done;
  }

  // The button loads late, so keep checking for a few seconds
  let tries = 0;
  const timer = setInterval(function () {
    if (styleShopButtons() || ++tries > 40) clearInterval(timer);
  }, 250);
})();
</script>



