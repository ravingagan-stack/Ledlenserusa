{%- comment -%}
  Outputs a light output value with its lumens unit, e.g. "2,000" → "2,000 lumens".
  Values that already include a unit ("2,000 lm", "2,000 lumens") are output unchanged.

  Accepts:
  - value: {String} Raw output value (e.g. a metafield via `| metafield_text`)

  Usage:
  {% render 'spec-lumens', value: product.metafields.custom.max_lumens | metafield_text %}
{%- endcomment -%}

{%- liquid
  assign raw = value | strip

  if raw != blank
    # Normalise any unit spelling ("lm", "lumens", "Lumen") to " lm" and ranges to an en dash.
    assign num = raw | replace: 'LUMENS', '' | replace: 'Lumens', '' | replace: 'lumens', '' | replace: 'Lumen', '' | replace: 'lumen', ''
    assign num = num | replace: 'LM', '' | replace: 'Lm', '' | replace: 'lm', '' | strip
    assign num = num | replace: ' - ', '–' | replace: ' – ', '–' | replace: '-', '–'
    echo num | append: ' lm'
  endif
-%}
