{%- liquid
  assign section_uid = 'CompareTiers-' | append: section.id
  assign active_col = section.settings.highlighted_tier | minus: 1
-%}

{%- style -%}
    #{{ section_uid }} {
    max-width: 1408px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }

   .ct__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 8px;
  }

   .ct__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 44px;
    line-height: 1;
    margin: 0;
  }

   .ct__link {
    font-weight: 600;
    font-size: 16px;
        font-family: Barlow, Helvetica Neue, sans-serif;
    line-height: 20px;
    text-decoration: underline;
    color: #0a0a0a;
  }

   .ct__subtitle {
    margin: 0 0 8px;
    color: {{ section.settings.color_muted }};
    font-size: 16px;
        font-family: Barlow, Helvetica Neue, sans-serif;
        line-height:19px;
  }

   .ct__scroll {
    overflow-x: auto;
  }

   .ct__grid {
    display: grid;
    grid-template-columns: 200px repeat(3, minmax(220px, 1fr));
    min-width: 860px;
    border-top: 1px solid {{ section.settings.color_border }};
    padding-top:21px;
  }

   .ct__corner {
    padding: 18px 16px;
  }

   .ct__head {
    display: block;
    width: 100%;
    border-radius:0;
    padding: 18px 16px;
    text-align: left;
    background: transparent;
    border: 0;
    border-top: 3px solid transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

   .ct__tag {
    display: block;
    font-size: 12px;
    line-height:14px;
    font-family: Barlow;
font-weight: 700;
font-style: Bold;
font-size: 12px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0.96px;
vertical-align: middle;
text-transform: uppercase;

    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: {{ section.settings.color_accent }};
    min-height: 16px;
  }

   .ct__name {
    display: block;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 30px;
    text-transform: uppercase;
    line-height:36px;
  }

   .ct__price {
    display: block;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height:26px;
    margin-top: 2px;
  }

   .ct__label {
    padding: 14px 16px;
    border-top: 1px solid {{ section.settings.color_border }};
    font-size: 13px;
        font-family: Barlow, Helvetica Neue, sans-serif;
        line-height:16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: {{ section.settings.color_muted }};
  }

   .ct__cell {
    padding: 14px 16px;
    border-top: 1px solid {{ section.settings.color_border }};
    font-size: 15px;
    color:#0A0A0A;
        font-family: Barlow, Helvetica Neue, sans-serif;
        font-family: Barlow;
font-weight: 600;
font-style: SemiBold;
font-size: 16px;
leading-trim: NONE;
line-height: 19px;
letter-spacing: 0%;
vertical-align: middle;

  }

   .ct__foot-spacer {
    padding: 16px;
  }

   .ct__foot {
    padding: 16px;
  }

   .ct__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    background: {{ section.settings.color_button_bg }};
    color: {{ section.settings.color_button_text }};
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 17px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Highlighted column */
   .ct__grid[data-active="0"] [data-col="0"],
   .ct__grid[data-active="1"] [data-col="1"],
   .ct__grid[data-active="2"] [data-col="2"] {
    background: {{ section.settings.color_highlight_bg }};
  }

   .ct__head[aria-pressed="true"] {
    border-top-color: {{ section.settings.color_accent }};
  }

  /* Specs that change between tiers */
  #{{ section_uid }} .ct__label.is-varies {
    box-shadow: inset 3px 0 0 {{ section.settings.color_accent }};
  }

  #{{ section_uid }} .ct__cell.is-top {
    color: {{ section.settings.color_accent }};
  }

  #{{ section_uid }} .ct__badge {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 6px;
    border-radius: 3px;
    background: {{ section.settings.color_accent }};
    color: #ffffff;
    font-family: Barlow, Helvetica Neue, sans-serif;
    font-size: 10px;
    font-weight: 700;
    line-height: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 2px;
    white-space: nowrap;
  }

  #{{ section_uid }} .ct__badge--top {
    background: transparent;
    color: {{ section.settings.color_accent }};
    border: 1px solid currentColor;
    padding: 1px 5px;
  }

  @media only screen and (max-width: 749px) {
      #{{ section_uid }} {
            padding: 50px 20px;
      }
      h2.ct__title {
    font-size: 30px;
}

.ct__header {
    margin-bottom: 14px;
}
.ct__grid {
    display: grid;
    grid-template-columns: 154px repeat(3, minmax(154px, 1fr));
    min-width: 860px;
    border-top: 1px solid #dadada;
    padding-top: 21px;
}
.ct__label {
    padding: 14px 10px;
}
span.ct__name {
    font-size: 24px;
    line-height: normal;
}
    }
{%- endstyle -%}

<section id="{{ section_uid }}" class="ct">
  <div class="ct__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="ct__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link_url | default: '#' }}" class="ct__link">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  {%- if section.settings.subheading != blank -%}
    <p class="ct__subtitle">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div class="ct__scroll">
    {%- liquid
      comment
        Tier products: the "Product" setting, else the product in the button link
        ("/products/<handle>"). Rows with a data source read their specs from these.
      endcomment
      assign tp1 = section.settings.tier_1_product
      assign tp2 = section.settings.tier_2_product
      assign tp3 = section.settings.tier_3_product
      for i in (1..3)
        assign url_key = 'tier_' | append: i | append: '_url'
        assign tier_link = section.settings[url_key] | append: ''
        if tier_link contains '/products/'
          assign tier_handle = tier_link | split: '/products/' | last | split: '?' | first | split: '#' | first
          case i
            when 1
              if tp1 == blank
                assign tp1 = all_products[tier_handle]
              endif
            when 2
              if tp2 == blank
                assign tp2 = all_products[tier_handle]
              endif
            when 3
              if tp3 == blank
                assign tp3 = all_products[tier_handle]
              endif
          endcase
        endif
      endfor
    -%}

    <div class="ct__grid" data-active="{{ active_col }}">
      <div class="ct__corner"></div>

      {%- for i in (1..3) -%}
        {%- liquid
          assign col = i | minus: 1
          assign tag_key = 'tier_' | append: i | append: '_tag'
          assign name_key = 'tier_' | append: i | append: '_name'
          assign price_key = 'tier_' | append: i | append: '_price'
        -%}
        <button
          type="button"
          class="ct__head"
          data-col="{{ col }}"
          aria-pressed="{% if col == active_col %}true{% else %}false{% endif %}"
        >
          <span class="ct__tag">{{ section.settings[tag_key] }}</span>
          <span class="ct__name">{{ section.settings[name_key] }}</span>
          <span class="ct__price">{{ section.settings[price_key] }}</span>
        </button>
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- liquid
          comment
            Highlight rows where a number changes between tiers; "Highest" marks the top value
            for specs where more is better (output, distance, runtime, battery).
          endcomment
          assign label_lower = block.settings.label | downcase

          comment
            Cell values: from each tier product's Specifications data when the row has a
            data source, falling back to the typed value when the product has none.
          endcomment
          assign c1 = block.settings.value_1
          assign c2 = block.settings.value_2
          assign c3 = block.settings.value_3
          assign spec_source = block.settings.source | default: 'manual'
          if spec_source != 'manual'
            if tp1 != blank
              capture spec_value
                render 'tier-spec-value', product: tp1, source: spec_source
              endcapture
              if spec_value != blank
                assign c1 = spec_value
              endif
            endif
            if tp2 != blank
              capture spec_value
                render 'tier-spec-value', product: tp2, source: spec_source
              endcapture
              if spec_value != blank
                assign c2 = spec_value
              endif
            endif
            if tp3 != blank
              capture spec_value
                render 'tier-spec-value', product: tp3, source: spec_source
              endcapture
              if spec_value != blank
                assign c3 = spec_value
              endif
            endif
          endif

          capture n1
            render 'spec-number', value: c1
          endcapture
          capture n2
            render 'spec-number', value: c2
          endcapture
          capture n3
            render 'spec-number', value: c3
          endcapture

          assign is_varies = false
          assign mark_top = false
          assign top_num = -1
          if n1 != blank and n2 != blank and n3 != blank
            assign v1 = n1 | times: 1
            assign v2 = n2 | times: 1
            assign v3 = n3 | times: 1
            if v1 != v2 or v1 != v3
              assign is_varies = true
            endif
            assign top_num = v1
            if v2 > top_num
              assign top_num = v2
            endif
            if v3 > top_num
              assign top_num = v3
            endif
          endif

          if is_varies
            if label_lower contains 'lumen' or label_lower contains 'output' or label_lower contains 'beam' or label_lower contains 'distance' or label_lower contains 'range' or label_lower contains 'runtime' or label_lower contains 'run time' or label_lower contains 'battery' or label_lower contains 'capacity'
              assign mark_top = true
            endif
          endif
        -%}
        <div class="ct__label{% if is_varies %} is-varies{% endif %}" {{ block.shopify_attributes }}>
          {{- block.settings.label -}}
          {%- if is_varies %} <span class="ct__badge">Varies</span>{% endif -%}
        </div>
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign cell_value = c1
              when 2
                assign cell_value = c2
              when 3
                assign cell_value = c3
            endcase
            assign is_top = false
            if mark_top
              case i
                when 1
                  if v1 == top_num
                    assign is_top = true
                  endif
                when 2
                  if v2 == top_num
                    assign is_top = true
                  endif
                when 3
                  if v3 == top_num
                    assign is_top = true
                  endif
              endcase
            endif
          -%}
          <div class="ct__cell{% if is_varies %} is-varies{% endif %}{% if is_top %} is-top{% endif %}" data-col="{{ i | minus: 1 }}">
            {{- cell_value -}}
            {%- if is_top %} <span class="ct__badge ct__badge--top">Highest</span>{% endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}

      <div class="ct__foot-spacer"></div>

      {%- for i in (1..3) -%}
        {%- liquid
          assign col = i | minus: 1
          assign name_key = 'tier_' | append: i | append: '_name'
          assign url_key = 'tier_' | append: i | append: '_url'
          assign tier_url = section.settings[url_key] | default: '#'
        -%}
        <div class="ct__foot" data-col="{{ col }}">
          <a href="{{ tier_url }}" class="ct__btn">{{ section.settings.button_prefix }}&nbsp;{{ section.settings[name_key] }}</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('{{ section_uid }}');
    if (!root) return;
    var grid = root.querySelector('.ct__grid');
    var heads = root.querySelectorAll('.ct__head');

    heads.forEach(function (head) {
      head.addEventListener('click', function () {
        var col = head.getAttribute('data-col');
        grid.setAttribute('data-active', col);
        heads.forEach(function (h) {
          h.setAttribute('aria-pressed', h === head ? 'true' : 'false');
        });
      });
    });
  })();
</script>

