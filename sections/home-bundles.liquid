    min-width: 0;
    flex-shrink: 0;
    display: flex;
    gap: 16px;
    padding: 16px;
    align-items: center;
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.border_color }};
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: border-color .2s ease;
