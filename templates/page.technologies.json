        "padding_top": 40,
        "padding_bottom": 20
      }
    },
    "section_image_with_text_AA8xtH": {
      "type": "section-image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "title": "<p><strong>Temperature Control</strong></p>",
            "size": 100,
            "text_position": "left",
            "heading_highlight_type": "circle",
            "highlight_color": "#d43747",
            "highlight_text_color": "#000000",
            "spacing_bottom": 12
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Hard work leaves our lights cold: A Ledlenser never gets too hot, regardless of how much you use it. This protects you from burns and the LED from overheating.</p>",
            "size": 100,
            "text_position": "left",
            "spacing_bottom": 12
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ],
      "settings": {
        "increase_border_radius": false,
